---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../data/site_content_skeleton.json';
import {
  getPricing,
  getTourDisplayPrice
} from '../../lib/pricing';

export const prerender = true;

export function getStaticPaths() {
  const { tours } = content;
  return tours.map((tour) => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { business, tours: allTours } = content;
const pricing = await getPricing();

const durationToISO = (duration) => {
  const match = duration.match(/(\d+(?:\.\d+)?)\s*hours?/i);
  if (!match) return undefined;

  const hours = Number(match[1]);
  const wholeHours = Math.floor(hours);
  const minutes = Math.round((hours - wholeHours) * 60);

  return `PT${wholeHours}H${minutes ? `${minutes}M` : ''}`;
};

const schemaDuration = durationToISO(tour.duration);

const tourPriceNumeric = pricing[tour.id]?.from_price || parseInt(String(tour.price).replace(/[^0-9]/g, ''), 10) || 105000;

const tourSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": tour.title,
  "description": tour.description,
  "url": `https://www.caliculturaltours.com/tours/${tour.id}`,
  "image": `https://www.caliculturaltours.com/${tour.image}`,
  "duration": schemaDuration,
  "offers": {
    "@type": "Offer",
    "price": tourPriceNumeric,
    "priceCurrency": "COP",
    "availability": "https://schema.org/InStock",
    "url": `https://www.caliculturaltours.com/book?tour=${tour.id}`
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "48",
    "bestRating": "5",
    "worstRating": "1"
  },
  "provider": {
    "@type": "LocalBusiness",
    "additionalType": "https://en.wikipedia.org/wiki/Tour_operator",
    "name": business.name,
    "url": "https://www.caliculturaltours.com"
  }
};

// Related tours: prioritize same category, then fill with others
const relatedTours = [
  ...allTours
    .filter(
      t =>
        t.id !== tour.id &&
        t.category === tour.category
    )
    .sort((a, b) => a.display_order - b.display_order),

  ...allTours
    .filter(
      t =>
        t.id !== tour.id &&
        t.category !== tour.category
    )
    .sort((a, b) => a.display_order - b.display_order)

].slice(0, 2);
---

<BaseLayout
    title={tour.title}
    description={tour.description}
    ogImage={`/${tour.image}`}
    schema={tourSchema}
>
    <section class="section tour-detail-section tour-inverted">
        <div class="container">
            <nav class="reveal" style="margin-bottom: 40px;">
                <a href="/tours" class="back-link" style="margin: 0;">
                    <i class="fas fa-arrow-left"></i> Back to Tours
                </a>
            </nav>

            <div class="tour-detail-grid">
                
                <!-- 1. GALLERY (Area: gallery) -->
                <div class="tour-gallery-area">
                    <div class="tour-gallery-viewer" id="galleryViewer">
                        <img id="mainImage" src={`/${tour.image}`} alt={tour.title} class="main-tour-img" />
                        
                        <button type="button" class="gallery-nav-btn prev" id="galleryPrevBtn" aria-label="Previous photo">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button type="button" class="gallery-nav-btn next" id="galleryNextBtn" aria-label="Next photo">
                            <i class="fas fa-chevron-right"></i>
                        </button>

                        <button type="button" class="gallery-fullscreen-btn" id="galleryExpandBtn" aria-label="View photo fullscreen">
                            <i class="fas fa-expand"></i>
                        </button>

                        <div class="gallery-counter" id="galleryCounter">
                            1 / {(tour.gallery || [tour.image]).length}
                        </div>
                    </div>

                    <div class="tour-thumbnails" id="thumbnailContainer">
                        {(tour.gallery || [tour.image]).map((img, idx, arr) => {
                            const isMainImage = img === tour.image || `/${img}` === `/${tour.image}`;
                            return (
                                <img 
                                    src={`/${img}`} 
                                    alt={`thumbnail ${idx + 1}`} 
                                    class={`thumb-img ${isMainImage ? 'active' : ''}`}
                                    data-src={`/${img}`}
                                    data-index={idx}
                                    onclick="setActiveThumb(this)"
                                />
                            );
                        })}
                    </div>
                </div>

                <!-- Fullscreen Lightbox Modal -->
                <div id="galleryLightbox" class="gallery-lightbox" aria-hidden="true" role="dialog">
                    <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Close fullscreen view">
                        <i class="fas fa-times"></i>
                    </button>
                    <button type="button" class="lightbox-nav-btn prev" id="lightboxPrevBtn" aria-label="Previous photo">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button type="button" class="lightbox-nav-btn next" id="lightboxNextBtn" aria-label="Next photo">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <div class="lightbox-image-wrap">
                        <img id="lightboxImage" src="" alt="Fullscreen tour photo" />
                    </div>
                    <div class="lightbox-counter" id="lightboxCounter"></div>
                </div>

                <!-- 2. HEADER & PRICE (Area: info) -->
                <div class="tour-info-area">
                    <div class="conversion-sticky-wrapper">
                        <div class="tour-info-header">
                            <span class="tour-category-tag">{tour.category}</span>
                            <h1 class="text-serif">{tour.title}</h1>
                            <div class="tour-meta-row">
    <span>
        <i class="fas fa-person-walking"></i>
        {tour.type}
    </span>

    <span>
        <i class="fas fa-clock"></i>
        {tour.duration}
    </span>

    <span>
        <i class="fas fa-wand-magic-sparkles"></i>
        {tour.feature}
    </span>
</div>
{tour.highlight && (
    <div class="tour-highlight">
        <div class="tour-highlight-title">
            <i class="fas fa-wand-magic-sparkles"></i>
            Tour Highlight
        </div>

        <p>{tour.highlight}</p>
    </div>
)}
                            {(tour.physical_level || tour.languages || tour.meeting_point || tour.discount) && (
                                <div class="tour-extra-meta">
                                    {tour.physical_level && <span><i class="fas fa-hiking"></i> {tour.physical_level}</span>}
                                    {tour.languages && <span><i class="fas fa-language"></i> {tour.languages}</span>}
                                    {tour.meeting_point && <span><i class="fas fa-map-marker-alt"></i> {tour.meeting_point}</span>}
                                    {tour.discount && <span><i class="fas fa-tag"></i> {tour.discount}</span>}
                                </div>
                            )}
                        </div>

                        <div class="price-card-floating">
                            <div class="price-content">
                                <span class="price-label">Price from</span>
                                <span class="price-value">
                                {getTourDisplayPrice(tour, pricing)}
                                                                    </span>
                                <span class="price-label">per person</span>
                            </div>
                            <a href={`/book?tour=${tour.id}`} class="btn btn-primary btn-block">
                                Book This Tour
                            </a>
                            <p class="price-footer-note">
                                Secure online payment.
                            </p>
                        </div>

                        <!-- SHARE TOUR BUTTON & MODAL -->
                        <div class="tour-share-container">
                            <button type="button" class="tour-share-btn" id="openShareModalBtn" aria-label="Share this tour">
                                <i class="fas fa-arrow-up-from-bracket"></i>
                                <span>Share this experience</span>
                            </button>
                        </div>

                        <!-- Share Modal Popup -->
                        <div id="tourShareModal" class="share-modal" aria-hidden="true" role="dialog">
                            <div class="share-modal-backdrop" id="shareModalBackdrop"></div>
                            <div class="share-modal-content">
                                <div class="share-modal-header">
                                    <h3>Share Experience</h3>
                                    <button type="button" class="share-modal-close" id="closeShareModalBtn" aria-label="Close share dialog">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <p class="share-modal-subtitle">Share <strong>{tour.title}</strong> with travel companions or friends:</p>
                                
                                <div class="share-buttons-grid">
                                    <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Check out this tour in Cali, Colombia: ${tour.title} — https://www.caliculturaltours.com/tours/${tour.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn whatsapp">
                                        <div class="share-icon"><i class="fab fa-whatsapp"></i></div>
                                        <span>WhatsApp</span>
                                    </a>

                                    <a href={`fb-messenger://share/?link=${encodeURIComponent(`https://www.caliculturaltours.com/tours/${tour.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn messenger" id="messengerShareLink">
                                        <div class="share-icon"><i class="fab fa-facebook-messenger"></i></div>
                                        <span>Messenger</span>
                                    </a>

                                    <a href={`https://t.me/share/url?url=${encodeURIComponent(`https://www.caliculturaltours.com/tours/${tour.id}`)}&text=${encodeURIComponent(`Check out ${tour.title} in Cali with Cali Cultural Tours!`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn telegram">
                                        <div class="share-icon"><i class="fab fa-telegram-plane"></i></div>
                                        <span>Telegram</span>
                                    </a>

                                    <button type="button" class="share-channel-btn native-share" id="nativeShareTriggerBtn">
                                        <div class="share-icon"><i class="fas fa-share-nodes"></i></div>
                                        <span>More Apps</span>
                                    </button>
                                </div>

                                <div class="share-copy-box">
                                    <input type="text" readonly value={`https://www.caliculturaltours.com/tours/${tour.id}`} id="shareUrlInput" class="share-url-field" />
                                    <button type="button" class="share-copy-btn" id="copyShareUrlBtn">
                                        <i class="fas fa-copy"></i>
                                        <span id="copyBtnText">Copy Link</span>
                                    </button>
                                </div>
                                <div id="copySuccessAlert" class="copy-success-message" style="display: none;">
                                    <i class="fas fa-check-circle"></i> Clean link copied to clipboard!
                                </div>
                            </div>
                        </div>
                        
                        <div class="tour-description-box reveal">
                            <p>{tour.description}</p>
                        </div>
                    </div>
                </div>

                <!-- 3. INCLUSIONS & ITINERARY (Area: details) -->
                <div class="tour-details-area">
                    <div class="inclusions-grid-v2 reveal">
                        <div class="inclusion-block">
                            <h4>What's Included</h4>
                            <ul class="inclusion-list">
                                {(tour.included || []).map((item: string) => (
                                    <li><i class="fas fa-check"></i> {item}</li>
                                ))}
                            </ul>
                        </div>
                        <div class="inclusion-block">
                            <h4>Not Included</h4>
                            <ul class="inclusion-list">
                                {(tour.not_included || []).map((item: string) => (
                                    <li><i class="fas fa-times"></i> {item}</li>
                                ))}
                            </ul>
                        </div>
                    </div>

                    <div class="itinerary-section reveal">
                        <h4>Itinerary</h4>
                        <ul class="itinerary-list">
                            {(tour.itinerary || []).map((step: string, idx: number) => (
                                <div class="itinerary-item">
                                    <span class="itinerary-time">Step {idx + 1}</span>
                                    <span class="itinerary-desc">{step}</span>
                                </div>
                            ))}
                        </ul>
                    </div>

                    {tour.youtube_video_id && (
                        <div class="itinerary-section reveal" style="margin-top: 32px;">
                            <h4>{tour.video_title || "Watch the Experience"}</h4>
                            <div class="tour-video-wrapper">
                                <iframe 
                                    src={`https://www.youtube.com/embed/${tour.youtube_video_id}`} 
                                    title={tour.video_title || tour.title}
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen
                                ></iframe>
                            </div>
                        </div>
                    )}

                    {tour.notes && tour.notes.length > 0 && (
                        <div class="itinerary-section reveal" style="margin-top: 24px;">
                            <h4>Good to Know</h4>
                            <ul class="inclusion-list" style="list-style: none; padding: 0;">
                                {(tour.notes as string[]).map((note: string) => (
                                    <li class="good-to-know-item">
                                        <i class="fas fa-info-circle"></i> {note}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </div>

            </div>
        </div>
    </section>

    <!-- RELATED TOURS SECTION -->
    <section class="section tour-related-section">
        <div class="container reveal">
            <h2 class="text-serif" style="text-align: center; margin-bottom: 48px; font-size: 2.5rem;">You may also like</h2>
            
            <div class="tours-grid" style="max-width: 800px; margin: 0 auto;">
                {relatedTours.map((relatedTour, index) => (
                    <a href={`/tours/${relatedTour.id}`} class={`tour-card reveal delay-${index + 1}`}>
                        <div class="tour-card-img">
                            <img src={`/${relatedTour.image}`} alt={relatedTour.title} />
                            {relatedTour.popular && <span class="tour-badge">Popular</span>}
                        </div>
                        <div class="tour-card-body">
                            <span class="tour-category-tag" style="font-size: 0.65rem; padding: 4px 8px; margin-bottom: 8px;">{relatedTour.category}</span>
                            <h3>{relatedTour.title}</h3>
                            <div class="tour-card-meta">
    <span>
        <i class="fas fa-person-walking"></i>
        {relatedTour.type}
    </span>

    <span>
        <i class="fas fa-clock"></i>
        {relatedTour.duration}
    </span>

    <span>
        <i class="fas fa-wand-magic-sparkles"></i>
        {relatedTour.feature}
    </span>
</div>
                            <p style="font-size: 0.95rem; color: var(--cct-text-light); line-height: 1.5;">{relatedTour.description}</p>
                            <div class="tour-card-footer">
                                <span class="tour-price">{relatedTour.price}</span>
                                <span class="tour-card-link" style="color: var(--cct-primary); font-weight: 600; font-size: 0.9rem;">View Details <i class="fas fa-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>

            <div style="text-align: center; margin-top: 48px;">
                <a href="/tours" class="btn btn-outline">Explore All Tours</a>
            </div>
        </div>
    </section>

    <script is:inline>
        let currentPhotoIndex = 0;
        let photosList = [];

        function initGallery() {
            const thumbs = document.querySelectorAll('#thumbnailContainer .thumb-img');
            photosList = Array.from(thumbs).map(t => t.dataset.src);
            if (photosList.length === 0) return;

            // Find current active index
            const activeThumb = document.querySelector('#thumbnailContainer .thumb-img.active');
            if (activeThumb && activeThumb.dataset.index) {
                currentPhotoIndex = parseInt(activeThumb.dataset.index, 10);
            }
            updateGalleryUI();

            // Swipe on main viewer
            const viewer = document.getElementById('galleryViewer');
            if (viewer) {
                let touchStartX = 0;
                let touchStartY = 0;
                let touchEndX = 0;
                let touchEndY = 0;

                viewer.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                    touchStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                viewer.addEventListener('touchend', (e) => {
                    touchEndX = e.changedTouches[0].screenX;
                    touchEndY = e.changedTouches[0].screenY;
                    handleSwipeGesture(touchStartX, touchStartY, touchEndX, touchEndY);
                }, { passive: true });

                // Open lightbox when clicking the main image or expand button
                const mainImg = document.getElementById('mainImage');
                if (mainImg) {
                    mainImg.addEventListener('click', openLightbox);
                }
                const expandBtn = document.getElementById('galleryExpandBtn');
                if (expandBtn) {
                    expandBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        openLightbox();
                    });
                }
            }

            // Prev / Next buttons on main viewer
            document.getElementById('galleryPrevBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(-1);
            });
            document.getElementById('galleryNextBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(1);
            });

            // Lightbox controls
            document.getElementById('lightboxCloseBtn')?.addEventListener('click', closeLightbox);
            document.getElementById('lightboxPrevBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(-1);
            });
            document.getElementById('lightboxNextBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(1);
            });

            // Close lightbox on backdrop click
            const lightbox = document.getElementById('galleryLightbox');
            if (lightbox) {
                lightbox.addEventListener('click', (e) => {
                    if (e.target === lightbox || e.target.classList.contains('lightbox-image-wrap')) {
                        closeLightbox();
                    }
                });

                // Swipe in lightbox
                let lbStartX = 0;
                let lbStartY = 0;
                lightbox.addEventListener('touchstart', (e) => {
                    lbStartX = e.changedTouches[0].screenX;
                    lbStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                lightbox.addEventListener('touchend', (e) => {
                    const lbEndX = e.changedTouches[0].screenX;
                    const lbEndY = e.changedTouches[0].screenY;
                    handleSwipeGesture(lbStartX, lbStartY, lbEndX, lbEndY);
                }, { passive: true });
            }

            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                const lb = document.getElementById('galleryLightbox');
                const isLbOpen = lb && lb.classList.contains('active');
                if (e.key === 'ArrowLeft') {
                    navigateGallery(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateGallery(1);
                } else if (e.key === 'Escape' && isLbOpen) {
                    closeLightbox();
                }
            });
        }

        function handleSwipeGesture(startX, startY, endX, endY) {
            const diffX = endX - startX;
            const diffY = endY - startY;
            // Ensure horizontal swipe is dominant and above threshold (40px)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                if (diffX < 0) {
                    navigateGallery(1); // Swipe left -> Next photo
                } else {
                    navigateGallery(-1); // Swipe right -> Prev photo
                }
            }
        }

        function navigateGallery(direction) {
            if (photosList.length <= 1) return;
            currentPhotoIndex = (currentPhotoIndex + direction + photosList.length) % photosList.length;
            updateGalleryUI();
        }

        function setActiveThumb(thumb) {
            const idx = parseInt(thumb.dataset.index, 10);
            if (!isNaN(idx)) {
                currentPhotoIndex = idx;
                updateGalleryUI();
            }
        }

        function updateGalleryUI() {
            if (photosList.length === 0) return;
            const currentSrc = photosList[currentPhotoIndex];

            // Update main image
            const mainImg = document.getElementById('mainImage');
            if (mainImg && mainImg.src !== currentSrc) {
                mainImg.style.opacity = '0.7';
                setTimeout(() => {
                    mainImg.src = currentSrc;
                    mainImg.style.opacity = '1';
                }, 120);
            }

            // Update counter
            const counter = document.getElementById('galleryCounter');
            if (counter) {
                counter.textContent = `${currentPhotoIndex + 1} / ${photosList.length}`;
            }

            // Update thumbnails active state & scroll into view
            const thumbs = document.querySelectorAll('#thumbnailContainer .thumb-img');
            thumbs.forEach((t, i) => {
                if (i === currentPhotoIndex) {
                    t.classList.add('active');
                    t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                } else {
                    t.classList.remove('active');
                }
            });

            // Update lightbox if open
            const lbImg = document.getElementById('lightboxImage');
            const lbCounter = document.getElementById('lightboxCounter');
            if (lbImg) lbImg.src = currentSrc;
            if (lbCounter) lbCounter.textContent = `${currentPhotoIndex + 1} / ${photosList.length}`;
        }

        function openLightbox() {
            const lightbox = document.getElementById('galleryLightbox');
            if (!lightbox) return;
            lightbox.classList.add('active');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            updateGalleryUI();
        }

        function closeLightbox() {
            const lightbox = document.getElementById('galleryLightbox');
            if (!lightbox) return;
            lightbox.classList.remove('active');
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        // Initialize on load and on Astro view transitions
        document.addEventListener('DOMContentLoaded', initGallery);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initGallery();
        }

        // Share Modal & Clipboard Logic
        function initShareModule() {
            const openBtn = document.getElementById('openShareModalBtn');
            const closeBtn = document.getElementById('closeShareModalBtn');
            const backdrop = document.getElementById('shareModalBackdrop');
            const modal = document.getElementById('tourShareModal');
            const copyBtn = document.getElementById('copyShareUrlBtn');
            const copyInput = document.getElementById('shareUrlInput');
            const copyText = document.getElementById('copyBtnText');
            const copyAlert = document.getElementById('copySuccessAlert');
            const nativeBtn = document.getElementById('nativeShareTriggerBtn');

            const tourUrl = window.location.href.split('?')[0]; // Clean link without query params
            const tourTitle = document.title || 'Tour in Cali, Colombia';

            if (copyInput) copyInput.value = tourUrl;

            // Handle Messenger fallback on desktop (web dialog if desktop)
            const messengerBtn = document.getElementById('messengerShareLink');
            if (messengerBtn && !/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
                messengerBtn.href = `https://www.facebook.com/dialog/send?link=${encodeURIComponent(tourUrl)}&app_id=291494419107518&redirect_uri=${encodeURIComponent(tourUrl)}`;
            }

            function openModal() {
                if (!modal) return;
                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                if (!modal) return;
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            openBtn?.addEventListener('click', () => {
                // If Web Share API is supported on mobile, offer native share directly, or open modal
                openModal();
            });

            closeBtn?.addEventListener('click', closeModal);
            backdrop?.addEventListener('click', closeModal);

            // Copy to clipboard
            copyBtn?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(tourUrl);
                    if (copyText) copyText.textContent = 'Copied!';
                    if (copyAlert) {
                        copyAlert.style.display = 'flex';
                        setTimeout(() => {
                            copyAlert.style.display = 'none';
                            if (copyText) copyText.textContent = 'Copy Link';
                        }, 2500);
                    }
                } catch (err) {
                    copyInput?.select();
                    document.execCommand('copy');
                }
            });

            // Native Web Share API trigger
            nativeBtn?.addEventListener('click', async () => {
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: tourTitle,
                            text: `Check out ${tourTitle} with Cali Cultural Tours!`,
                            url: tourUrl,
                        });
                        closeModal();
                    } catch (err) {
                        // User cancelled
                    }
                } else {
                    // Fallback to copy link
                    copyBtn?.click();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', initShareModule);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initShareModule();
        }
    </script>
</BaseLayout>
