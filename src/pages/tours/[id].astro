---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../data/site_content_skeleton.json';
import {
  getPricing,
  getTourDisplayPrice
} from '../../lib/pricing';
import {
  getPhotoStatsMap,
  rankTourGallery
} from '../../lib/photoStats';

export const prerender = false;

const { id } = Astro.params;
const { business, tours: allTours } = content;
const tour = (allTours as any[]).find((t) => t.id === id);

if (!tour) {
  return new Response('Tour not found', { status: 404 });
}

// Cache rendered tour page at Vercel Edge CDN (30 min fresh, 24h stale-while-revalidate)
// Keeps SEO/LCP fast while letting the photo popularity order update automatically
Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=86400');

const [pricing, photoStats] = await Promise.all([
  getPricing(),
  getPhotoStatsMap(),
]);

const { heroImage, gallery: rankedGallery } = rankTourGallery(tour, photoStats);

const durationToISO = (duration: string) => {
  const match = duration.match(/(\d+(?:\.\d+)?)\s*hours?/i);
  if (!match) return undefined;

  const hours = Number(match[1]);
  const wholeHours = Math.floor(hours);
  const minutes = Math.round((hours - wholeHours) * 60);

  return `PT${wholeHours}H${minutes ? `${minutes}M` : ''}`;
};

const schemaDuration = durationToISO(tour.duration);

const tourPriceNumeric = pricing[tour.id]?.from_price || parseInt(String(tour.price).replace(/[^0-9]/g, ''), 10) || 105000;

const tourSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": tour.h1 || tour.title,
  "description": tour.meta_description || tour.description,
  "url": `https://www.caliculturaltours.com/tours/${tour.id}`,
  "image": `https://www.caliculturaltours.com/${heroImage}`,
  "duration": schemaDuration,
  "offers": {
    "@type": "Offer",
    "price": tourPriceNumeric,
    "priceCurrency": "COP",
    "availability": "https://schema.org/InStock",
    "url": `https://www.caliculturaltours.com/book?tour=${tour.id}`
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "48",
    "bestRating": "5",
    "worstRating": "1"
  },
  "provider": {
    "@type": "LocalBusiness",
    "additionalType": "https://en.wikipedia.org/wiki/Tour_operator",
    "name": business.name,
    "url": "https://www.caliculturaltours.com"
  }
};

const faqSchema = Array.isArray(tour.faqs) && tour.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": tour.faqs.map((faq: { question: string; answer: string }) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  : null;

const pageSchemas = faqSchema ? [tourSchema, faqSchema] : tourSchema;

// Related tours: use explicit cross_sell list when provided, else prioritize same category
const relatedTours = tour.cross_sell?.tour_ids?.length
  ? tour.cross_sell.tour_ids
      .map((id: string) => allTours.find(t => t.id === id))
      .filter(Boolean)
  : [
      ...allTours
        .filter(
          t =>
            t.id !== tour.id &&
            t.category === tour.category
        )
        .sort((a, b) => a.display_order - b.display_order),

      ...allTours
        .filter(
          t =>
            t.id !== tour.id &&
            t.category !== tour.category
        )
        .sort((a, b) => a.display_order - b.display_order)
    ].slice(0, 2);
---

<BaseLayout
    title={tour.meta_title || tour.title}
    exactTitle={Boolean(tour.meta_title)}
    description={tour.meta_description || tour.description}
    ogImage={`/${heroImage}`}
    schema={pageSchemas}
>
    <section class="section tour-detail-section tour-inverted">
        <div class="container">
            <nav class="reveal" style="margin-bottom: 40px;">
                <a href="/tours" class="back-link" style="margin: 0;">
                    <i class="fas fa-arrow-left"></i> Back to Tours
                </a>
            </nav>

            <div class="tour-detail-grid">
                
                <!-- 1. GALLERY (Area: gallery) -->
                <div class="tour-gallery-area">
                    <div class="tour-gallery-viewer" id="galleryViewer" data-tour-id={tour.id}>
                        <img id="mainImage" src={`/${heroImage}`} alt={tour.h1 || tour.title} class="main-tour-img" />
                        
                        <button type="button" class="gallery-nav-btn prev" id="galleryPrevBtn" aria-label="Previous photo">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button type="button" class="gallery-nav-btn next" id="galleryNextBtn" aria-label="Next photo">
                            <i class="fas fa-chevron-right"></i>
                        </button>

                        <button type="button" class="gallery-fullscreen-btn" id="galleryExpandBtn" aria-label="View photo fullscreen">
                            <i class="fas fa-expand"></i>
                        </button>

                        <div class="gallery-counter" id="galleryCounter">
                            1 / {rankedGallery.length}
                        </div>
                    </div>

                    <div class="tour-thumbnails" id="thumbnailContainer">
                        {rankedGallery.map((img, idx) => {
                            const isMainImage = idx === 0;
                            return (
                                <img 
                                    src={`/${img}`} 
                                    alt={`${tour.h1 || tour.title} photo ${idx + 1}`} 
                                    class={`thumb-img ${isMainImage ? 'active' : ''}`}
                                    data-src={`/${img}`}
                                    data-index={idx}
                                    loading={idx < 4 ? 'eager' : 'lazy'}
                                    decoding="async"
                                    onclick="setActiveThumb(this)"
                                />
                            );
                        })}
                    </div>
                </div>

                <!-- Fullscreen Lightbox Modal -->
                <div id="galleryLightbox" class="gallery-lightbox" aria-hidden="true" role="dialog">
                    <button type="button" class="lightbox-close-btn" id="lightboxCloseBtn" aria-label="Close fullscreen view">
                        <i class="fas fa-times"></i>
                    </button>
                    <button type="button" class="lightbox-nav-btn prev" id="lightboxPrevBtn" aria-label="Previous photo">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button type="button" class="lightbox-nav-btn next" id="lightboxNextBtn" aria-label="Next photo">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    <div class="lightbox-image-wrap">
                        <img id="lightboxImage" src="" alt="Fullscreen tour photo" />
                    </div>
                    <div class="lightbox-counter" id="lightboxCounter"></div>
                </div>

                <!-- 2. HEADER & PRICE (Area: info) -->
                <div class="tour-info-area">
                    <div class="conversion-sticky-wrapper">
                        <div class="tour-info-header">
                            <span class="tour-category-tag">{tour.category}</span>
                            <h1 class="text-serif">{tour.h1 || tour.title}</h1>
                            <div class="tour-meta-row">
    <span>
        <i class="fas fa-person-walking"></i>
        {tour.type}
    </span>

    <span>
        <i class="fas fa-clock"></i>
        {tour.duration}
    </span>

    <span>
        <i class="fas fa-wand-magic-sparkles"></i>
        {tour.feature}
    </span>
</div>
{(tour.highlights || tour.highlight) && (
    <div class="tour-highlight">
        <div class="tour-highlight-title">
            <i class="fas fa-wand-magic-sparkles"></i>
            {Array.isArray(tour.highlights) ? 'Tour Highlights' : 'Tour Highlight'}
        </div>

        {Array.isArray(tour.highlights) && tour.highlights.length > 0 ? (
            <ul class="tour-highlight-list">
                {tour.highlights.map((item: string) => (
                    <li>
                        <i class="fas fa-check-circle" aria-hidden="true"></i>
                        <span>{item}</span>
                    </li>
                ))}
            </ul>
        ) : (
            <p>{tour.highlight}</p>
        )}
    </div>
)}
                            {Array.isArray(tour.trust_badges) && tour.trust_badges.length > 0 ? (
                                <div class="tour-trust-banner" aria-label="Why Book Direct with Us">
                                    <div class="tour-trust-banner-title">Why Book Direct with Us</div>
                                    <div class="tour-trust-grid">
                                        {tour.trust_badges.map((badge: { icon: string; label: string }) => (
                                            <div class="tour-trust-item">
                                                <i class={`fas ${badge.icon}`} aria-hidden="true"></i>
                                                <span>{badge.label}</span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ) : (tour.physical_level || tour.languages || tour.meeting_point || tour.discount) && (
                                <div class="tour-extra-meta">
                                    {tour.physical_level && <span><i class="fas fa-hiking"></i> {tour.physical_level}</span>}
                                    {tour.languages && <span><i class="fas fa-language"></i> {tour.languages}</span>}
                                    {tour.meeting_point && <span><i class="fas fa-map-marker-alt"></i> {tour.meeting_point}</span>}
                                    {tour.discount && <span><i class="fas fa-tag"></i> {tour.discount}</span>}
                                </div>
                            )}
                        </div>

                        <div class="price-card-floating">
                            <div class="price-content">
                                <span class="price-label">Price from</span>
                                <span class="price-value">
                                {getTourDisplayPrice(tour, pricing)}
                                                                    </span>
                                <span class="price-label">per person</span>
                            </div>
                            <a href={`/book?tour=${tour.id}`} class="btn btn-primary btn-block">
                                Book This Tour
                            </a>
                            <p class="price-footer-note">
                                Secure online payment.
                            </p>
                        </div>

                        <!-- SHARE TOUR BUTTON & MODAL -->
                        <div class="tour-share-container">
                            <button type="button" class="tour-share-btn" id="openShareModalBtn" aria-label="Share this tour">
                                <i class="fas fa-arrow-up-from-bracket"></i>
                                <span>Share this experience</span>
                            </button>
                        </div>

                        <!-- Share Modal Popup -->
                        <div id="tourShareModal" class="share-modal" aria-hidden="true" role="dialog">
                            <div class="share-modal-backdrop" id="shareModalBackdrop"></div>
                            <div class="share-modal-content">
                                <div class="share-modal-header">
                                    <h3>Share Experience</h3>
                                    <button type="button" class="share-modal-close" id="closeShareModalBtn" aria-label="Close share dialog">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                                <p class="share-modal-subtitle">Share <strong>{tour.title}</strong> with travel companions or friends:</p>
                                
                                <div class="share-buttons-grid">
                                    <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`Check out this tour in Cali, Colombia: ${tour.title} — https://www.caliculturaltours.com/tours/${tour.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn whatsapp">
                                        <div class="share-icon"><i class="fab fa-whatsapp"></i></div>
                                        <span>WhatsApp</span>
                                    </a>

                                    <a href={`fb-messenger://share/?link=${encodeURIComponent(`https://www.caliculturaltours.com/tours/${tour.id}`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn messenger" id="messengerShareLink">
                                        <div class="share-icon"><i class="fab fa-facebook-messenger"></i></div>
                                        <span>Messenger</span>
                                    </a>

                                    <a href={`https://t.me/share/url?url=${encodeURIComponent(`https://www.caliculturaltours.com/tours/${tour.id}`)}&text=${encodeURIComponent(`Check out ${tour.title} in Cali with Cali Cultural Tours!`)}`} target="_blank" rel="noopener noreferrer" class="share-channel-btn telegram">
                                        <div class="share-icon"><i class="fab fa-telegram-plane"></i></div>
                                        <span>Telegram</span>
                                    </a>

                                    <button type="button" class="share-channel-btn native-share" id="nativeShareTriggerBtn">
                                        <div class="share-icon"><i class="fas fa-share-nodes"></i></div>
                                        <span>More Apps</span>
                                    </button>
                                </div>

                                <div class="share-copy-box">
                                    <input type="text" readonly value={`https://www.caliculturaltours.com/tours/${tour.id}`} id="shareUrlInput" class="share-url-field" />
                                    <button type="button" class="share-copy-btn" id="copyShareUrlBtn">
                                        <i class="fas fa-copy"></i>
                                        <span id="copyBtnText">Copy Link</span>
                                    </button>
                                </div>
                                <div id="copySuccessAlert" class="copy-success-message" style="display: none;">
                                    <i class="fas fa-check-circle"></i> Clean link copied to clipboard!
                                </div>
                            </div>
                        </div>
                        
                        <div class="tour-description-box reveal">
                            {tour.editorial_box ? (
                                <>
                                    <h4 class="tour-editorial-title">{tour.editorial_box.title}</h4>
                                    <p>{tour.editorial_box.text}</p>
                                </>
                            ) : (
                                <p>{tour.description}</p>
                            )}
                        </div>
                    </div>
                </div>

                <!-- 3. INCLUSIONS & ITINERARY (Area: details) -->
                <div class="tour-details-area">
                    <div class="inclusions-grid-v2 reveal">
                        <div class="inclusion-block">
                            <h4>What's Included</h4>
                            <ul class="inclusion-list">
                                {(tour.included || []).map((item: string) => (
                                    <li><i class="fas fa-check"></i> <span>{item}</span></li>
                                ))}
                            </ul>
                        </div>
                        <div class="inclusion-block">
                            <h4>Not Included</h4>
                            <ul class="inclusion-list">
                                {(tour.not_included || []).map((item: string) => (
                                    <li><i class="fas fa-times"></i> <span>{item}</span></li>
                                ))}
                            </ul>
                        </div>
                    </div>

                    <div class="itinerary-section reveal">
                        <h4>Itinerary</h4>
                        <ul class="itinerary-list">
                            {(tour.itinerary || []).map((step: any, idx: number) => {
                                const isObj = step && typeof step === 'object';
                                const badgeText = isObj ? (step.badge || `Step ${idx + 1}`) : `Step ${idx + 1}`;
                                return (
                                    <li class="itinerary-item">
                                        <span class="itinerary-time">{badgeText}</span>
                                        <div class="itinerary-desc">
                                            {isObj ? (
                                                <>
                                                    {step.title && <strong class="itinerary-step-title">{step.title}: </strong>}
                                                    <span>{step.text}</span>
                                                    {step.mapUrl && (
                                                        <div class="itinerary-map-wrap">
                                                            <a href={step.mapUrl} target="_blank" rel="noopener noreferrer" class="itinerary-map-link">
                                                                <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                                                {step.mapLabel || "View on Google Maps"}
                                                            </a>
                                                        </div>
                                                    )}
                                                </>
                                            ) : (
                                                step
                                            )}
                                        </div>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>

                    {tour.peace_of_mind && Array.isArray(tour.peace_of_mind.items) && tour.peace_of_mind.items.length > 0 && (
                        <div class="tour-peace-banner reveal" aria-label={tour.peace_of_mind.title || "Peace of Mind"}>
                            {tour.peace_of_mind.title && (
                                <div class="tour-peace-banner-title">{tour.peace_of_mind.title}</div>
                            )}
                            <div class="tour-peace-grid">
                                {tour.peace_of_mind.items.map((item: { icon: string; label: string; sub?: string }) => (
                                    <div class="tour-peace-item">
                                        <div class="tour-peace-icon">
                                            <i class={`fas ${item.icon}`} aria-hidden="true"></i>
                                        </div>
                                        <div class="tour-peace-text">
                                            <strong>{item.label}</strong>
                                            {item.sub && <span>{item.sub}</span>}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {tour.discovery_grid && Array.isArray(tour.discovery_grid.items) && tour.discovery_grid.items.length > 0 && (
                        <div class="itinerary-section tour-discovery-section reveal" style="margin-top: 24px;">
                            <h4>{tour.discovery_grid.title}</h4>
                            {tour.discovery_grid.subtitle && (
                                <p class="tour-discovery-subtitle">{tour.discovery_grid.subtitle}</p>
                            )}
                            <div class="tour-discovery-grid">
                                {tour.discovery_grid.items.map((item: { name: string; flavor: string; image: string; alt: string; description: string }) => (
                                    <article class="tour-discovery-card">
                                        <div class="tour-discovery-img-wrap">
                                            <img src={`/${item.image}`} alt={item.alt || item.name} loading="lazy" decoding="async" />
                                            <span class="tour-discovery-flavor">{item.flavor}</span>
                                        </div>
                                        <div class="tour-discovery-body">
                                            <h5>{item.name}</h5>
                                            <p>{item.description}</p>
                                        </div>
                                    </article>
                                ))}
                            </div>
                        </div>
                    )}

                    {tour.youtube_video_id && (
                        <div class="itinerary-section reveal" style="margin-top: 32px;">
                            <h4>{tour.video_title || "Watch the Experience"}</h4>
                            <div class="tour-video-wrapper">
                                <iframe 
                                    src={`https://www.youtube.com/embed/${tour.youtube_video_id}`} 
                                    title={tour.video_title || tour.title}
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen
                                ></iframe>
                            </div>
                        </div>
                    )}

                    {tour.notes && tour.notes.length > 0 && (
                        <div class="itinerary-section reveal" style="margin-top: 24px;">
                            <h4>Good to Know</h4>
                            <ul class="inclusion-list" style="list-style: none; padding: 0;">
                                {(tour.notes as string[]).map((note: string) => {
                                    const colonIdx = note.indexOf(':');
                                    const hasPrefix = colonIdx > 0 && colonIdx < 35;
                                    const prefix = hasPrefix ? note.slice(0, colonIdx + 1) : '';
                                    const bodyText = hasPrefix ? note.slice(colonIdx + 1).trim() : note;
                                    return (
                                        <li class="good-to-know-item">
                                            <i class="fas fa-info-circle" aria-hidden="true"></i>
                                            <span>{prefix && <strong>{prefix} </strong>}{bodyText}</span>
                                        </li>
                                    );
                                })}
                            </ul>
                        </div>
                    )}

                    {Array.isArray(tour.faqs) && tour.faqs.length > 0 && (
                        <div class="itinerary-section tour-faq-section reveal" style="margin-top: 24px;">
                            <h4>Frequently Asked Questions</h4>
                            <div class="tour-faq-list">
                                {tour.faqs.map((faq: { question: string; answer: string }, fIdx: number) => (
                                    <details class="tour-faq-item" open={fIdx === 0}>
                                        <summary class="tour-faq-question">
                                            <span>{faq.question}</span>
                                            <i class="fas fa-chevron-down tour-faq-chevron" aria-hidden="true"></i>
                                        </summary>
                                        <div class="tour-faq-answer">
                                            <p>{faq.answer}</p>
                                        </div>
                                    </details>
                                ))}
                            </div>
                        </div>
                    )}
                </div>

            </div>
        </div>
    </section>

    <!-- RELATED TOURS / CROSS-SELL SECTION -->
    <section class="section tour-related-section">
        <div class="container reveal">
            <h2 class="text-serif" style={`text-align: center; margin-bottom: ${tour.cross_sell?.subtitle ? '14px' : '48px'}; font-size: 2.5rem;`}>
                {tour.cross_sell?.heading || "You may also like"}
            </h2>
            {tour.cross_sell?.subtitle && (
                <p class="tour-related-subtitle">{tour.cross_sell.subtitle}</p>
            )}
            
            <div class="tours-grid" style="max-width: 800px; margin: 0 auto;">
                {relatedTours.map((relatedTour, index) => {
                    const relatedHero = rankTourGallery(relatedTour, photoStats).heroImage || relatedTour.image;
                    return (
                    <a href={`/tours/${relatedTour.id}`} class={`tour-card reveal delay-${index + 1}`}>
                        <div class="tour-card-img">
                            <img src={`/${relatedHero}`} alt={relatedTour.title} />
                            {relatedTour.popular && <span class="tour-badge">Popular</span>}
                        </div>
                        <div class="tour-card-body">
                            <span class="tour-category-tag" style="font-size: 0.65rem; padding: 4px 8px; margin-bottom: 8px;">{relatedTour.category}</span>
                            <h3>{relatedTour.title}</h3>
                            <div class="tour-card-meta">
    <span>
        <i class="fas fa-person-walking"></i>
        {relatedTour.type}
    </span>

    <span>
        <i class="fas fa-clock"></i>
        {relatedTour.duration}
    </span>

    <span>
        <i class="fas fa-wand-magic-sparkles"></i>
        {relatedTour.feature}
    </span>
</div>
                            <p style="font-size: 0.95rem; color: var(--cct-text-light); line-height: 1.5;">{relatedTour.description}</p>
                            <div class="tour-card-footer">
                                <span class="tour-price">{getTourDisplayPrice(relatedTour, pricing)}</span>
                                <span class="tour-card-link" style="color: var(--cct-primary); font-weight: 600; font-size: 0.9rem;">View Details <i class="fas fa-arrow-right"></i></span>
                            </div>
                        </div>
                    </a>
                    );
                })}
            </div>

            <div style="text-align: center; margin-top: 48px;">
                <a href="/tours" class="btn btn-outline">Explore All Tours</a>
            </div>
        </div>
    </section>

    <script is:inline>
        let currentPhotoIndex = 0;
        let photosList = [];
        let galleryInitialized = false;
        let activeTourId = '';
        let dwellTimer = null;

        // Per-visit deduplicated telemetry buffers
        const sentMetrics = {
            thumb: new Set(),
            lightbox: new Set(),
            dwell: new Set(),
        };
        const pendingDelta = new Map();

        function queuePhotoSignal(photoSrc, kind) {
            if (!photoSrc || !activeTourId || navigator.webdriver) return;
            const set = sentMetrics[kind];
            if (!set || set.has(photoSrc)) return;
            set.add(photoSrc);

            const entry = pendingDelta.get(photoSrc) || {
                photo: photoSrc,
                thumbClick: 0,
                lightboxOpen: 0,
                dwellView: 0,
            };
            if (kind === 'thumb') entry.thumbClick = 1;
            if (kind === 'lightbox') entry.lightboxOpen = 1;
            if (kind === 'dwell') entry.dwellView = 1;
            pendingDelta.set(photoSrc, entry);

            if (kind === 'lightbox' && typeof window.clarity === 'function') {
                try {
                    window.clarity('event', 'tour_photo_lightbox_open');
                } catch {}
            }
        }

        function scheduleDwellCheck(photoSrc) {
            if (dwellTimer) clearTimeout(dwellTimer);
            if (!photoSrc) return;
            dwellTimer = setTimeout(() => {
                if (document.visibilityState === 'visible') {
                    queuePhotoSignal(photoSrc, 'dwell');
                }
            }, 1500);
        }

        function flushPhotoTelemetry() {
            if (dwellTimer) {
                clearTimeout(dwellTimer);
                dwellTimer = null;
            }
            if (!activeTourId || pendingDelta.size === 0) return;

            const events = Array.from(pendingDelta.values());
            pendingDelta.clear();

            const payload = JSON.stringify({ tourId: activeTourId, events });
            try {
                if (navigator.sendBeacon) {
                    const blob = new Blob([payload], { type: 'application/json' });
                    navigator.sendBeacon('/api/photo-stats', blob);
                } else {
                    fetch('/api/photo-stats', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload,
                        keepalive: true,
                    });
                }
            } catch {}
        }

        function initGallery() {
            if (galleryInitialized) return;
            const thumbs = document.querySelectorAll('#thumbnailContainer .thumb-img');
            photosList = Array.from(thumbs).map(t => t.dataset.src);
            if (photosList.length === 0) return;

            const viewer = document.getElementById('galleryViewer');
            activeTourId = viewer?.dataset?.tourId || '';
            galleryInitialized = true;

            // Find current active index (initial load is never tracked as a click)
            const activeThumb = document.querySelector('#thumbnailContainer .thumb-img.active');
            if (activeThumb && activeThumb.dataset.index) {
                currentPhotoIndex = parseInt(activeThumb.dataset.index, 10);
            }
            updateGalleryUI(false);

            // Swipe on main viewer
            if (viewer) {
                let touchStartX = 0;
                let touchStartY = 0;
                let touchEndX = 0;
                let touchEndY = 0;

                viewer.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                    touchStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                viewer.addEventListener('touchend', (e) => {
                    touchEndX = e.changedTouches[0].screenX;
                    touchEndY = e.changedTouches[0].screenY;
                    handleSwipeGesture(touchStartX, touchStartY, touchEndX, touchEndY);
                }, { passive: true });

                // Open lightbox when clicking the main image or expand button
                const mainImg = document.getElementById('mainImage');
                if (mainImg) {
                    mainImg.addEventListener('click', openLightbox);
                }
                const expandBtn = document.getElementById('galleryExpandBtn');
                if (expandBtn) {
                    expandBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        openLightbox();
                    });
                }
            }

            // Prev / Next buttons on main viewer
            document.getElementById('galleryPrevBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(-1);
            });
            document.getElementById('galleryNextBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(1);
            });

            // Lightbox controls
            document.getElementById('lightboxCloseBtn')?.addEventListener('click', closeLightbox);
            document.getElementById('lightboxPrevBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(-1);
            });
            document.getElementById('lightboxNextBtn')?.addEventListener('click', (e) => {
                e.stopPropagation();
                navigateGallery(1);
            });

            // Close lightbox on backdrop click
            const lightbox = document.getElementById('galleryLightbox');
            if (lightbox) {
                lightbox.addEventListener('click', (e) => {
                    if (e.target === lightbox || e.target.classList.contains('lightbox-image-wrap')) {
                        closeLightbox();
                    }
                });

                // Swipe in lightbox
                let lbStartX = 0;
                let lbStartY = 0;
                lightbox.addEventListener('touchstart', (e) => {
                    lbStartX = e.changedTouches[0].screenX;
                    lbStartY = e.changedTouches[0].screenY;
                }, { passive: true });

                lightbox.addEventListener('touchend', (e) => {
                    const lbEndX = e.changedTouches[0].screenX;
                    const lbEndY = e.changedTouches[0].screenY;
                    handleSwipeGesture(lbStartX, lbStartY, lbEndX, lbEndY);
                }, { passive: true });
            }

            // Keyboard navigation
            document.addEventListener('keydown', (e) => {
                const lb = document.getElementById('galleryLightbox');
                const isLbOpen = lb && lb.classList.contains('active');
                if (e.key === 'ArrowLeft') {
                    navigateGallery(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateGallery(1);
                } else if (e.key === 'Escape' && isLbOpen) {
                    closeLightbox();
                }
            });

            // Flush accumulated telemetry cleanly when visitor leaves/hides tab
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'hidden') {
                    flushPhotoTelemetry();
                }
            });
            window.addEventListener('pagehide', flushPhotoTelemetry);

            // Global Tour Popularity Tracking (counts visits from /tours, Travel Guides, Google, Ads, WhatsApp, etc.)
            function sendTourSignal(payloadObj) {
                if (!activeTourId || navigator.webdriver) return;
                const payload = JSON.stringify({ tourId: activeTourId, ...payloadObj });
                try {
                    if (navigator.sendBeacon) {
                        const blob = new Blob([payload], { type: 'application/json' });
                        navigator.sendBeacon('/api/tour-stats', blob);
                    } else {
                        fetch('/api/tour-stats', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: payload,
                            keepalive: true,
                        });
                    }
                } catch {}
            }

            if (activeTourId && !navigator.webdriver) {
                const viewKey = 'cct_tour_viewed_' + activeTourId;
                if (!sessionStorage.getItem(viewKey)) {
                    setTimeout(() => {
                        if (document.visibilityState === 'visible' && !sessionStorage.getItem(viewKey)) {
                            sessionStorage.setItem(viewKey, '1');
                            const fromGuide = /\/guides\//i.test(document.referrer || '');
                            sendTourSignal({ view: 1, fromGuide });
                        }
                    }, 800);
                }
            }

            document.querySelector('.price-card-floating a')?.addEventListener('click', () => {
                flushPhotoTelemetry();
                if (activeTourId && !navigator.webdriver) {
                    const bookKey = 'cct_tour_book_' + activeTourId;
                    if (!sessionStorage.getItem(bookKey)) {
                        sessionStorage.setItem(bookKey, '1');
                        sendTourSignal({ bookClick: 1 });
                    }
                }
            });
        }

        function handleSwipeGesture(startX, startY, endX, endY) {
            const diffX = endX - startX;
            const diffY = endY - startY;
            // Ensure horizontal swipe is dominant and above threshold (40px)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                if (diffX < 0) {
                    navigateGallery(1); // Swipe left -> Next photo
                } else {
                    navigateGallery(-1); // Swipe right -> Prev photo
                }
            }
        }

        function navigateGallery(direction) {
            if (photosList.length <= 1) return;
            currentPhotoIndex = (currentPhotoIndex + direction + photosList.length) % photosList.length;
            updateGalleryUI(true, 'navigate');
        }

        function setActiveThumb(thumb) {
            const idx = parseInt(thumb.dataset.index, 10);
            if (!isNaN(idx)) {
                currentPhotoIndex = idx;
                updateGalleryUI(true, 'thumb');
            }
        }

        function updateGalleryUI(isUserAction = false, interactionKind = 'thumb') {
            if (photosList.length === 0) return;
            const currentSrc = photosList[currentPhotoIndex];

            // Update main image
            const mainImg = document.getElementById('mainImage');
            if (mainImg && mainImg.getAttribute('src') !== currentSrc) {
                mainImg.style.opacity = '0.7';
                setTimeout(() => {
                    mainImg.src = currentSrc;
                    mainImg.style.opacity = '1';
                }, 120);
            }

            // Update counter
            const counter = document.getElementById('galleryCounter');
            if (counter) {
                counter.textContent = `${currentPhotoIndex + 1} / ${photosList.length}`;
            }

            // Update thumbnails active state & scroll into view only on user action
            const thumbs = document.querySelectorAll('#thumbnailContainer .thumb-img');
            thumbs.forEach((t, i) => {
                if (i === currentPhotoIndex) {
                    t.classList.add('active');
                    if (isUserAction) {
                        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                    }
                } else {
                    t.classList.remove('active');
                }
            });

            // Update lightbox if open
            const lightbox = document.getElementById('galleryLightbox');
            const isLbOpen = lightbox && lightbox.classList.contains('active');
            const lbImg = document.getElementById('lightboxImage');
            const lbCounter = document.getElementById('lightboxCounter');
            if (lbImg) lbImg.src = currentSrc;
            if (lbCounter) lbCounter.textContent = `${currentPhotoIndex + 1} / ${photosList.length}`;

            // Record engagement signal only on explicit user interaction
            if (isUserAction && currentSrc) {
                if (isLbOpen || interactionKind === 'lightbox') {
                    queuePhotoSignal(currentSrc, 'lightbox');
                } else {
                    queuePhotoSignal(currentSrc, 'thumb');
                }
                scheduleDwellCheck(currentSrc);
            }
        }

        function openLightbox() {
            const lightbox = document.getElementById('galleryLightbox');
            if (!lightbox) return;
            lightbox.classList.add('active');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            updateGalleryUI(true, 'lightbox');
        }

        function closeLightbox() {
            const lightbox = document.getElementById('galleryLightbox');
            if (!lightbox) return;
            lightbox.classList.remove('active');
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            flushPhotoTelemetry();
        }

        // Initialize on load and on Astro view transitions
        document.addEventListener('DOMContentLoaded', initGallery);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initGallery();
        }

        // Share Modal & Clipboard Logic
        function initShareModule() {
            const openBtn = document.getElementById('openShareModalBtn');
            const closeBtn = document.getElementById('closeShareModalBtn');
            const backdrop = document.getElementById('shareModalBackdrop');
            const modal = document.getElementById('tourShareModal');
            const copyBtn = document.getElementById('copyShareUrlBtn');
            const copyInput = document.getElementById('shareUrlInput');
            const copyText = document.getElementById('copyBtnText');
            const copyAlert = document.getElementById('copySuccessAlert');
            const nativeBtn = document.getElementById('nativeShareTriggerBtn');

            const tourUrl = window.location.href.split('?')[0]; // Clean link without query params
            const tourTitle = document.title || 'Tour in Cali, Colombia';

            if (copyInput) copyInput.value = tourUrl;

            // Handle Messenger fallback on desktop (web dialog if desktop)
            const messengerBtn = document.getElementById('messengerShareLink');
            if (messengerBtn && !/Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
                messengerBtn.href = `https://www.facebook.com/dialog/send?link=${encodeURIComponent(tourUrl)}&app_id=291494419107518&redirect_uri=${encodeURIComponent(tourUrl)}`;
            }

            function openModal() {
                if (!modal) return;
                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                if (!modal) return;
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            openBtn?.addEventListener('click', () => {
                // If Web Share API is supported on mobile, offer native share directly, or open modal
                openModal();
            });

            closeBtn?.addEventListener('click', closeModal);
            backdrop?.addEventListener('click', closeModal);

            // Copy to clipboard
            copyBtn?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(tourUrl);
                    if (copyText) copyText.textContent = 'Copied!';
                    if (copyAlert) {
                        copyAlert.style.display = 'flex';
                        setTimeout(() => {
                            copyAlert.style.display = 'none';
                            if (copyText) copyText.textContent = 'Copy Link';
                        }, 2500);
                    }
                } catch (err) {
                    copyInput?.select();
                    document.execCommand('copy');
                }
            });

            // Native Web Share API trigger
            nativeBtn?.addEventListener('click', async () => {
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: tourTitle,
                            text: `Check out ${tourTitle} with Cali Cultural Tours!`,
                            url: tourUrl,
                        });
                        closeModal();
                    } catch (err) {
                        // User cancelled
                    }
                } else {
                    // Fallback to copy link
                    copyBtn?.click();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', initShareModule);
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            initShareModule();
        }
    </script>
</BaseLayout>
