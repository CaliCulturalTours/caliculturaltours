<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Copy HOSTEE Coupon Code
    const copyBtn = document.getElementById('copyHosteeCodeBtn');
    const copyLabel = document.getElementById('copyHosteeCodeLabel');
    const codeText = document.getElementById('hosteeCodeText')?.textContent?.trim() || 'HOSTEE';

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeText);
      } catch {
        const tmp = document.createElement('input');
        tmp.value = codeText;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        document.body.removeChild(tmp);
      }
      copyBtn.classList.add('copied');
      if (copyLabel) copyLabel.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        if (copyLabel) copyLabel.textContent = 'Copy Code';
      }, 2200);
    });

    // 2. Horizontal Tour Slider Arrows
    const track = document.getElementById('hosteeSliderTrack');
    const prevBtn = document.getElementById('hosteePrevBtn');
    const nextBtn = document.getElementById('hosteeNextBtn');

    function scrollSlider(dir) {
      if (!track) return;
      const step = Math.min(track.clientWidth * 0.85, 720);
      track.scrollBy({ left: dir * step, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollSlider(-1));
    nextBtn?.addEventListener('click', () => scrollSlider(1));

    // 3. Category Filter Pills
    const filterPills = document.querySelectorAll('.hostee-filter-pill');
    const slides = document.querySelectorAll('.hostee-tour-slide');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const selected = pill.getAttribute('data-filter');
        slides.forEach((slide) => {
          const group = slide.getAttribute('data-group');
          if (selected === 'all' || group === selected) {
            slide.classList.remove('is-hidden');
          } else {
            slide.classList.add('is-hidden');
          }
        });

        if (track) track.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });
  });
</script>
