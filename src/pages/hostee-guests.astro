---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/site_content_skeleton.json';
import { getPricing } from '../lib/pricing';
import { getPhotoStatsMap, rankTourGallery } from '../lib/photoStats';
import { getTourStatsMap, rankToursForCatalog } from '../lib/tourStats';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=86400');

const HOSTEE_CODE = 'HOSTEE';
const HOSTEE_DISCOUNT = 7;

const [pricing, photoStats, tourStats] = await Promise.all([
  getPricing(),
  getPhotoStatsMap(),
  getTourStatsMap(),
]);

const rankedTours = rankToursForCatalog(content.tours as any[], tourStats);

function getBaseNumericPrice(tour: any): number {
  const dynamicPrice = pricing[tour.id]?.from_price;
  if (dynamicPrice) return Number(dynamicPrice);
  const parsed = parseInt(String(tour.price || '').replace(/[^0-9]/g, ''), 10);
  return isNaN(parsed) ? 0 : parsed;
}

function getFilterGroup(category: string): string {
  const c = String(category || '').toLowerCase();
  if (c.includes('food') || c.includes('drink')) return 'food';
  if (c.includes('salsa') || c.includes('city') || c.includes('cultural')) return 'culture';
  return 'nature';
}

const toursWithPerks = rankedTours.map((tour) => {
  const heroImg = rankTourGallery(tour, photoStats).heroImage || tour.image;
  const basePrice = getBaseNumericPrice(tour);
  const hosteePrice = basePrice > 0 ? Math.round(basePrice * (1 - HOSTEE_DISCOUNT / 100)) : 0;
  return {
    ...tour,
    heroImg,
    basePrice,
    hosteePrice,
    filterGroup: getFilterGroup(tour.category),
  };
});

const hosteeWhatsappUrl =
  "https://wa.me/573162543554?text=Hi%20Juan%20Camilo!%20I'm%20a%20Hostee%20guest%20staying%20in%20Cali%20and%20would%20love%20to%20plan%20a%20tour%20with%20the%20HOSTEE%20discount.";

const reviews = [
  {
    name: 'David M.',
    country: 'United States',
    tour: 'Street Food Tour',
    text: "Juan Camilo showed us places we would have never found on our own. The lulada, empanadas, and local stories made this our highlight in Colombia!",
    platform: 'TripAdvisor',
  },
  {
    name: 'Sophie & Marc',
    country: 'France',
    tour: 'Pance Waterfalls Trip',
    text: "The perfect escape from the city heat. Refreshing mountain pools, super comfortable transport, and warm, genuine local hosting.",
    platform: 'Google Review',
  },
  {
    name: 'Elena R.',
    country: 'Canada',
    tour: 'San Cipriano River Tubing',
    text: "Riding the brujitas into the rainforest and floating down the emerald river was magical. One of the most unique experiences in Latin America.",
    platform: 'TripAdvisor',
  },
];
---

<BaseLayout
  title="Welcome Hostee Guests: Exclusive 7% Off Cali Tours"
  exactTitle={true}
  description="Exclusive perk for Hostee guests staying in Cali, Colombia: enjoy 7% off authentic local food, salsa, coffee, and nature tours with promo code HOSTEE."
  ogImage="/images/home-hero.webp"
  noindex={true}
>
  <!-- 1. VIP CO-BRANDED HERO -->
  <section class="hostee-hero">
    <div class="hostee-hero-overlay"></div>
    <div class="container hostee-hero-inner">
      <div class="hostee-hero-content reveal">
        <div class="hostee-cobrand-lockup">
          <img
            src="/images/partners/hostee-logo-white.webp"
            alt="Hostee — Rent a Place"
            class="hostee-partner-logo"
            width="420"
            height="333"
          />
          <span class="cobrand-x" aria-hidden="true">×</span>
          <div class="cct-cobrand-mark">
            <img src="/images/logo.jpg" alt="Cali Cultural Tours" width="44" height="44" />
            <span>Cali Cultural Tours</span>
          </div>
        </div>

        <div class="hostee-partner-pill">
          <i class="fas fa-star" style="color: #ff7ab0;"></i>
          <span>Exclusive Hostee Guest Perk</span>
        </div>

        <h1 class="text-serif hostee-hero-title">
          Welcome to Cali! Enjoy an Exclusive <span class="hostee-accent">7% Off</span> Local Experiences
        </h1>

        <p class="hostee-hero-subtitle">
          Because you are staying with <strong>Hostee</strong>, you have direct VIP access to Cali's highest-rated small-group and private tours: street food, exotic fruit markets, salsa culture, Andean coffee farms, and Pacific rainforest rivers led by native bilingual guides.
        </p>

        <div class="hostee-hero-actions">
          <a href={`/book?coupon=${HOSTEE_CODE}`} class="btn btn-primary hostee-cta-primary">
            <i class="fas fa-ticket-alt"></i> Book Now with 7% Off
          </a>
          <a href="#hostee-tours" class="btn btn-outline-white hostee-cta-secondary">
            Explore All 11 Tours <i class="fas fa-arrow-down" style="margin-left: 8px; margin-right: 0;"></i>
          </a>
        </div>
      </div>

      <!-- Interactive VIP Coupon Ticket -->
      <div class="hostee-coupon-card reveal delay-1">
        <div class="coupon-card-top">
          <span class="coupon-eyebrow">EXCLUSIVE PARTNER CODE</span>
          <div class="coupon-percent-badge">7% OFF</div>
        </div>

        <p class="coupon-card-desc">
          Apply this code at checkout (or click any tour below to apply it automatically):
        </p>

        <div class="coupon-code-box">
          <span class="coupon-code-value" id="hosteeCodeText">{HOSTEE_CODE}</span>
          <button type="button" class="coupon-copy-btn" id="copyHosteeCodeBtn" aria-label="Copy promo code HOSTEE">
            <i class="fas fa-copy"></i>
            <span id="copyHosteeCodeLabel">Copy Code</span>
          </button>
        </div>

        <div class="coupon-stack-note">
          <i class="fas fa-sparkles"></i>
          <span>
            <strong>Bonus Savings:</strong> Stacks with our <strong>10% Cash Discount</strong> when you choose <em>"Reserve &amp; Pay Cash"</em> (save over 16% combined, zero prepayment).
          </span>
        </div>

        <a href={`/book?coupon=${HOSTEE_CODE}`} class="btn btn-primary btn-block hostee-ticket-cta">
          Apply HOSTEE &amp; Check Availability
        </a>
      </div>
    </div>
  </section>

  <!-- 2. HOW YOUR PERK WORKS (3 SIMPLE STEPS) -->
  <section class="hostee-steps-strip">
    <div class="container">
      <div class="hostee-steps-grid">
        <div class="hostee-step-item reveal">
          <div class="hostee-step-num">1</div>
          <div>
            <h3>Pick Your Experience</h3>
            <p>Swipe through our 11 local food, salsa, city, and nature tours below.</p>
          </div>
        </div>
        <div class="hostee-step-item reveal delay-1">
          <div class="hostee-step-num">2</div>
          <div>
            <h3>Auto-Apply Code {HOSTEE_CODE}</h3>
            <p>Click <strong>"Book · 7% Off"</strong> on any card and your discount applies automatically.</p>
          </div>
        </div>
        <div class="hostee-step-item reveal delay-2">
          <div class="hostee-step-num">3</div>
          <div>
            <h3>Pay Online or Extra 10% Off in Cash</h3>
            <p>Instant confirmation, 100% guaranteed departures, even for solo travelers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. INTERACTIVE TOUR SLIDER / CAROUSEL -->
  <section id="hostee-tours" class="section hostee-tours-section">
    <div class="container">
      <div class="hostee-section-header reveal">
        <div>
          <span class="tour-category-tag">CURATED FOR HOSTEE GUESTS</span>
          <h2 class="text-serif hostee-section-title">Discover Authentic Cali</h2>
          <p class="hostee-section-lead">
            All prices below already show your exclusive <strong>7% Hostee guest discount</strong>. Click any tour to view full details or book directly.
          </p>
        </div>

        <div class="hostee-slider-controls" aria-label="Tour slider controls">
          <button type="button" class="hostee-slide-btn" id="hosteePrevBtn" aria-label="Previous tours">
            <i class="fas fa-chevron-left"></i>
          </button>
          <button type="button" class="hostee-slide-btn" id="hosteeNextBtn" aria-label="Next tours">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="hostee-filter-bar reveal delay-1" role="tablist" aria-label="Filter tours by category">
        <button type="button" class="hostee-filter-pill active" data-filter="all">
          <i class="fas fa-th-large"></i> All Experiences ({toursWithPerks.length})
        </button>
        <button type="button" class="hostee-filter-pill" data-filter="food">
          <i class="fas fa-utensils"></i> Food &amp; Coffee
        </button>
        <button type="button" class="hostee-filter-pill" data-filter="culture">
          <i class="fas fa-music"></i> Salsa &amp; City
        </button>
        <button type="button" class="hostee-filter-pill" data-filter="nature">
          <i class="fas fa-leaf"></i> Nature &amp; Day Trips
        </button>
      </div>

      <!-- Horizontal Swipeable Tour Slides Track -->
      <div class="hostee-slider-track" id="hosteeSliderTrack">
        {toursWithPerks.map((tour) => (
          <article class="hostee-tour-slide" data-group={tour.filterGroup}>
            <a href={`/tours/${tour.id}`} class="hostee-slide-img-wrap">
              <img src={`/${tour.heroImg}`} alt={tour.h1 || tour.title} loading="lazy" decoding="async" />
              <span class="hostee-slide-category">{tour.category}</span>
              <span class="hostee-slide-discount-badge">-7% HOSTEE</span>
            </a>

            <div class="hostee-slide-body">
              <div class="hostee-slide-meta">
                <span><i class="fas fa-clock"></i> {tour.duration}</span>
                <span><i class="fas fa-person-walking"></i> {tour.type}</span>
              </div>

              <h3 class="hostee-slide-title">
                <a href={`/tours/${tour.id}`}>{tour.title}</a>
              </h3>

              <p class="hostee-slide-desc">{tour.description}</p>

              <div class="hostee-slide-pricing">
                {tour.basePrice > 0 ? (
                  <>
                    <div class="hostee-price-original">
                      Regular: <span>{tour.basePrice.toLocaleString('en-US')} COP</span>
                    </div>
                    <div class="hostee-price-perk">
                      From <strong>{tour.hosteePrice.toLocaleString('en-US')} COP</strong>
                      <small>with {HOSTEE_CODE}</small>
                    </div>
                  </>
                ) : (
                  <div class="hostee-price-perk">
                    <strong>{tour.price}</strong> <small>(-7% with {HOSTEE_CODE})</small>
                  </div>
                )}
              </div>

              <div class="hostee-slide-actions">
                <a href={`/book?tour=${tour.id}&coupon=${HOSTEE_CODE}`} class="btn btn-primary hostee-book-btn">
                  Book · 7% Off
                </a>
                <a href={`/tours/${tour.id}`} class="btn btn-outline hostee-details-btn">
                  Details
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="hostee-swipe-hint">
        <i class="fas fa-hand-pointer"></i> Swipe or use arrows to browse all experiences
      </p>
    </div>
  </section>

  <!-- 4. MEGA TRAVEL GUIDE & RECOMMENDATIONS MAP SPOTLIGHT -->
  <section class="hostee-guide-section">
    <div class="container hostee-guide-grid">
      <div class="reveal">
        <span class="hostee-guide-eyebrow">FREE LOCAL RESOURCE FOR HOSTEE GUESTS</span>
        <h2 class="text-serif hostee-guide-title">
          New in Cali? Read Our <span style="color: #ff4b8b;">Ultimate Cali Travel Guide</span>
        </h2>
        <p class="hostee-guide-text">
          Make the most of your stay right from your Hostee apartment. We wrote an honest, practical local mega guide covering safe neighborhoods, the best salsa clubs, street food markets, transportation tips, weather, and day trips around Valle del Cauca.
        </p>

        <ul class="hostee-guide-bullets">
          <li><i class="fas fa-check-circle"></i> Honest neighborhood &amp; safety breakdown for travelers</li>
          <li><i class="fas fa-check-circle"></i> Local salsa clubs, live music nights, and top restaurants</li>
          <li><i class="fas fa-check-circle"></i> Interactive Google Map of handpicked spots across Cali</li>
        </ul>

        <div class="hostee-guide-actions">
          <a href="/guides/cali-colombia-travel-guide" class="btn btn-primary">
            <i class="fas fa-book-open"></i> Read the Mega Guide
          </a>
          <a href="/map" class="btn btn-outline-white">
            <i class="fas fa-map-marked-alt"></i> Local Recommendations Map
          </a>
        </div>
      </div>

      <div class="hostee-guide-media reveal delay-1">
        <a href="/guides/cali-colombia-travel-guide" class="hostee-guide-img-link">
          <img
            src="/images/blog/ultimate-guide-cali/hero.webp"
            alt="The Ultimate Local Travel Guide to Cali, Colombia"
            loading="lazy"
            decoding="async"
          />
          <span class="hostee-guide-badge">2026 Local Edition · Free</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. WHY HOSTEE GUESTS BOOK DIRECT + SOCIAL PROOF -->
  <section class="section hostee-trust-section">
    <div class="container">
      <div class="hostee-trust-header reveal">
        <span class="tour-category-tag">TRUSTED LOCAL PARTNER</span>
        <h2 class="text-serif">Why Hostee Guests Love Touring with Us</h2>
      </div>

      <div class="hostee-pillars-grid">
        <div class="hostee-pillar-card reveal">
          <div class="pillar-icon"><i class="fas fa-circle-check"></i></div>
          <h3>100% Guaranteed Departures</h3>
          <p>We never cancel due to low group numbers. Whether you travel solo or in a group, your booking runs.</p>
        </div>
        <div class="hostee-pillar-card reveal delay-1">
          <div class="pillar-icon"><i class="fas fa-car"></i></div>
          <h3>Apartment Pickup Options</h3>
          <p>Pickup at your Hostee apartment is included on day trips, and available as an optional add-on for walking tours.</p>
        </div>
        <div class="hostee-pillar-card reveal delay-2">
          <div class="pillar-icon"><i class="fas fa-star"></i></div>
          <h3>5.0 ★ Rated Bilingual Hosts</h3>
          <p>Licensed operator (RNT 196165) with top ratings on Google and TripAdvisor for genuine, safe local hosting.</p>
        </div>
        <div class="hostee-pillar-card reveal delay-3">
          <div class="pillar-icon"><i class="fas fa-hand-holding-heart"></i></div>
          <h3>Support Local Micro-Entrepreneurs</h3>
          <p>Every tour directly supports family bakeries, fruit vendors, coffee growers, and independent artists in Cali.</p>
        </div>
      </div>

      <!-- Traveler Reviews -->
      <div class="hostee-reviews-grid">
        {reviews.map((r, i) => (
          <div class={`hostee-review-card reveal delay-${i + 1}`}>
            <div class="review-top-row">
              <div class="review-stars" aria-label="5 out of 5 stars">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
              </div>
              <span class="review-platform">{r.platform}</span>
            </div>
            <p class="review-quote">"{r.text}"</p>
            <div class="review-author">
              <strong>{r.name}</strong>
              <span>{r.country} · {r.tour}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. DIRECT WHATSAPP CONCIERGE BANNER -->
  <section class="hostee-concierge-section">
    <div class="container">
      <div class="hostee-concierge-card reveal">
        <div class="concierge-avatar-wrap">
          <img src="/images/juan-camilo.webp" alt="Juan Camilo, Founder of Cali Cultural Tours" loading="lazy" />
          <span class="concierge-online-dot" title="Online local host"></span>
        </div>

        <div class="concierge-copy">
          <span class="concierge-eyebrow">PERSONAL LOCAL CONCIERGE</span>
          <h2 class="text-serif">Need Advice or a Custom Private Tour?</h2>
          <p>
            Message Juan Camilo directly on WhatsApp for restaurant tips near your Hostee apartment, private transport for groups, or custom multi-day itineraries in Cali. Your <strong>7% HOSTEE discount</strong> applies there too!
          </p>
        </div>

        <div class="concierge-actions">
          <a
            href={hosteeWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hostee-wa-btn"
          >
            <i class="fab fa-whatsapp"></i> Chat on WhatsApp
          </a>
          <a href={`/book?coupon=${HOSTEE_CODE}`} class="btn btn-outline hostee-concierge-book">
            Book Online with {HOSTEE_CODE}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hostee-hero {
    position: relative;
    background-image: url('/images/home-hero.webp');
    background-size: cover;
    background-position: center;
    color: #ffffff;
    padding: clamp(64px, 8vw, 108px) 0;
    overflow: hidden;
  }

  .hostee-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(24, 5, 13, 0.9) 0%, rgba(138, 0, 54, 0.78) 55%, rgba(24, 5, 13, 0.88) 100%);
  }

  .hostee-hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.9fr);
    gap: 44px;
    align-items: center;
  }

  .hostee-cobrand-lockup {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
  }

  .hostee-partner-logo {
    height: 62px;
    width: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.25));
  }

  .cobrand-x {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ff7ab0;
    line-height: 1;
  }

  .cct-cobrand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .cct-cobrand-mark img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.65);
  }

  .cct-cobrand-mark span {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
    color: #ffffff;
    letter-spacing: 0.2px;
  }

  .hostee-partner-pill {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.32);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  .pill-brand {
    color: #ffffff;
    font-weight: 800;
  }

  .pill-x {
    color: #ff6ba3;
    font-weight: 800;
  }

  .pill-divider {
    opacity: 0.6;
  }

  .hostee-hero-title {
    font-size: clamp(2.15rem, 4.4vw, 3.4rem);
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 18px 0;
  }

  .hostee-accent {
    color: #ff7ab0;
  }

  .hostee-hero-subtitle {
    font-size: 1.08rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 28px 0;
    max-width: 580px;
  }

  .hostee-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hostee-cta-primary {
    background: linear-gradient(135deg, #e8005a 0%, #c4004c 100%);
    padding: 15px 28px;
    font-weight: 800;
    border-radius: 12px;
    box-shadow: 0 10px 26px rgba(232, 0, 90, 0.4);
  }

  .hostee-cta-secondary {
    padding: 15px 24px;
    border-radius: 12px;
    font-weight: 700;
  }

  /* VIP Coupon Ticket Card */
  .hostee-coupon-card {
    background: #ffffff;
    color: #1f2937;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  .coupon-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .coupon-eyebrow {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: #ba0047;
  }

  .coupon-percent-badge {
    background: linear-gradient(135deg, #e8005a 0%, #c4004c 100%);
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 800;
    padding: 5px 14px;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(232, 0, 90, 0.28);
  }

  .coupon-card-desc {
    font-size: 0.93rem;
    color: #4b5563;
    margin: 0 0 14px 0;
    line-height: 1.5;
  }

  .coupon-code-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff5f8;
    border: 2px dashed #e8005a;
    border-radius: 14px;
    padding: 12px 14px 12px 20px;
    margin-bottom: 16px;
  }

  .coupon-code-value {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #ba0047;
  }

  .coupon-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #18050d;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .coupon-copy-btn:hover {
    background: #e8005a;
    transform: translateY(-1px);
  }

  .coupon-copy-btn.copied {
    background: #15803d;
  }

  .coupon-stack-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #065f46;
    margin-bottom: 18px;
  }

  .coupon-stack-note i {
    color: #059669;
    margin-top: 3px;
    flex-shrink: 0;
  }

  .hostee-ticket-cta {
    background: linear-gradient(135deg, #e8005a 0%, #c4004c 100%);
    border-radius: 12px;
    font-weight: 800;
    padding: 14px;
    box-shadow: 0 8px 20px rgba(232, 0, 90, 0.3);
  }

  /* 3-Step Strip */
  .hostee-steps-strip {
    background: #ffffff;
    border-bottom: 1px solid #fae1ec;
    padding: 36px 0;
