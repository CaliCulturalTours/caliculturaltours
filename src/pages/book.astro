---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/site_content_skeleton.json';

const { tours } = content;

// We extract base prices by removing non-numeric characters for calculation purposes
const tourData = tours.map(t => {
    // Extract numbers: "From 95,000 COP" -> 95000
    const priceStr = t.price.replace(/[^0-9]/g, '');
    return {
        id: t.id,
        title: t.title,
        price: parseInt(priceStr, 10) || 0
    };
});
---

<BaseLayout title="Book Your Tour" description="Secure your spot in 3 easy steps">
    <section class="section section-light" style="background: #fafafa; min-height: 80vh;">
        <div class="container reveal">
            <!-- Header -->
            <div style="text-align: center; margin-bottom: 48px;">
                <h1 class="text-serif" style="font-size: 3rem; margin-bottom: 8px;">Book Your <span style="color: var(--cct-primary);">Tour</span></h1>
                <p style="color: var(--cct-text-light); font-size: 1.15rem;">Secure your spot in 3 easy steps</p>

                <!-- Stepper -->
                <div class="stepper-container">
                    <div class="step active" id="step-id-1">1</div>
                    <div class="step-line"></div>
                    <div class="step" id="step-id-2">2</div>
                    <div class="step-line"></div>
                    <div class="step" id="step-id-3">3</div>
                </div>
            </div>

            <!-- Form Card -->
            <div class="booking-card">
                <!-- STEP 1: Experience -->
                <div id="form-step-1" class="form-step active">
                    <h2 style="font-size: 1.5rem; margin-bottom: 24px; font-family: var(--font-serif);">Select Your Experience</h2>
                    
                    <div class="form-group">
                        <label class="form-label">Tour</label>
                        <select id="tour-select" class="form-control">
                            <option value="" disabled selected>Select a tour...</option>
                            {tourData.map(tour => (
                                <option value={tour.id} data-price={tour.price}>{tour.title}</option>
                            ))}
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Tour Date</label>
                            <input type="date" id="tour-date" class="form-control" />

<small style="color: var(--cct-text-light); display:block; margin-top:8px;">
    Need a tour today?
    <a href="https://wa.me/573162543554" target="_blank">
        Contact us on WhatsApp
    </a>
    to confirm availability.
</small>
                        </div>
                       <div class="form-group" style="flex: 1;">
    <label class="form-label">Preferred Start Time</label>
    <select id="tour-time" class="form-control">
        <option value="" disabled selected>Select a start time...</option>

        <option value="06:00 AM">06:00 AM</option>
        <option value="08:00 AM">08:00 AM</option>
        <option value="09:30 AM">09:30 AM</option>
        <option value="11:00 AM">11:00 AM</option>
        <option value="12:30 PM">12:30 PM</option>
        <option value="02:00 PM">02:00 PM</option>
        <option value="03:30 PM">03:30 PM</option>
        <option value="06:00 PM">06:00 PM</option>
        <option value="Other time">Other time</option>
    </select>
</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Number of Guests (Max 10)</label>
                        <div class="guest-counter">
                            <button type="button" class="qty-btn" id="qty-minus">-</button>
                            <input type="number" id="tour-guests" value="1" min="1" max="10" readonly />
                            <button type="button" class="qty-btn" id="qty-plus">+</button>
                        </div>
                    </div>

                    <div
    id="price-breakdown"
    style="
        display:none;
        background:#fafafa;
        border:1px solid #e6e6e6;
        border-radius:12px;
        padding:18px;
        margin-bottom:24px;
    ">

    <div
        style="
            display:flex;
            justify-content:space-between;
            margin-bottom:8px;
        ">
        <span>Price per person</span>
        <span id="breakdown-base-value"></span>
    </div>

    <div
        id="breakdown-discount-row"
        style="
            display:none;
            justify-content:space-between;
            color:#198754;
            margin-bottom:12px;
        ">
        <span>Group discount</span>
        <span id="breakdown-discount"></span>
    </div>

    <hr style="border:none;border-top:1px solid #ddd;margin:12px 0;">

    <div
        id="breakdown-total-row"
        style="
            display:flex;
            justify-content:space-between;
            align-items:center;
        ">
        <strong id="breakdown-total-label">
            Total
        </strong>

        <span
            id="breakdown-total"
            style="
                font-size:1.5rem;
                font-family:var(--font-serif);
                font-weight:800;
                color:var(--cct-primary);
            ">
        </span>
    </div>

    <div
        id="breakdown-per-person"
        style="
            display:none;
            text-align:center;
            margin-top:20px;
        ">

        <div
            style="
                font-size:.82rem;
                color:#777;
                text-transform:uppercase;
                letter-spacing:.08em;
            ">
            Your price per person
        </div>

        <div
            id="breakdown-per-person-value"
            style="
                font-size:2rem;
                font-family:var(--font-serif);
                font-weight:800;
                color:var(--cct-primary);
                margin-top:4px;
            ">
        </div>

    </div>

</div>

                    <button type="button" class="btn btn-primary btn-block" id="btn-next-1" style="padding: 16px; font-size: 1.1rem;">Continue</button>
                </div>

                <!-- STEP 2: Details -->
                <div id="form-step-2" class="form-step">
                    <h2 style="font-size: 1.5rem; margin-bottom: 24px; font-family: var(--font-serif);">Your Details</h2>
                    
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" id="user-name" class="form-control" placeholder="John Doe" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input type="email" id="user-email" class="form-control" placeholder="john@example.com" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">WhatsApp Number</label>
                        <input type="tel" id="user-phone" class="form-control" placeholder="+1 234 567 8900" />
                    </div>

                    <div class="form-row-buttons">
    <button type="button" class="btn btn-outline" id="btn-back-1" style="flex: 1;">
        Back
    </button>
</div>

<div class="form-row-buttons" style="margin-top: 12px;">
    <button type="button" class="btn btn-outline" id="btn-cash" style="flex: 1;">
        💵 Reserve &amp; Pay Cash · Save 10%
    </button>
</div>

<div class="form-row-buttons" style="margin-top: 12px;">
    <a href="#" class="btn btn-primary" id="btn-pay" style="flex: 1;">
        💳 Continue to Online Payment
    </a>
</div>
                </div>

            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .stepper-container {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 300px;
        margin: 0 auto;
        gap: 16px;
    }
    .step {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #eee;
        color: #999;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .step.active {
        background: var(--cct-primary);
        color: white;
        box-shadow: 0 4px 10px rgba(232, 0, 90, 0.3);
    }
    .step-line {
        height: 2px;
        flex: 1;
        background: #eee;
    }
    
    .booking-card {
        background: white;
        max-width: 600px;
        margin: 0 auto;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    }
    
    .form-step {
        display: none;
        animation: fadeIn 0.4s ease forwards;
    }
    .form-step.active {
        display: block;
    }
    
    .form-group {
        margin-bottom: 24px;
    }
    .form-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    .form-row-buttons {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }
    
    .form-label {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--cct-text-main);
    }
    
    .form-control {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #ddd;
        border-radius: 12px;
        font-size: 1rem;
        font-family: var(--font-body);
        color: var(--cct-text-main);
        background: #fafafa;
        transition: border-color 0.2s ease;
    }
    .form-control:focus {
        outline: none;
        border-color: var(--cct-primary);
        background: white;
    }
    
    .guest-counter {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .qty-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #ddd;
        background: white;
        font-weight: 700;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--cct-text-main);
    }
    .qty-btn:hover {
        border-color: var(--cct-primary);
        color: var(--cct-primary);
    }
    #tour-guests {
        width: 50px;
        text-align: center;
        border: none;
        font-size: 1.1rem;
        font-weight: 700;
        background: transparent;
    }
    
    .total-box {
        background: #fdf2f7;
        padding: 20px 24px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border: 1px solid #fae3ef;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 600px) {
        .booking-card {
            padding: 24px;
        }
        .form-row {
            flex-direction: column;
            gap: 0;
        }
    }
</style>

<div id="loading-overlay" class="loading-overlay">

    <img
        src="/images/logo.jpg"
        alt="Cali Cultural Tours"
        class="loading-logo"
    >

    <div class="loading-spinner"></div>

    <h2 class="loading-title">
        Preparing your reservation...
    </h2>

    <p class="loading-text">
        Please wait while we save your reservation.
    </p>

</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Elements
        const tourSelect = document.getElementById("tour-select");
        const qtyMinus = document.getElementById("qty-minus");
        const qtyPlus = document.getElementById("qty-plus");
        const tourGuests = document.getElementById("tour-guests");
        const breakdown = document.getElementById("price-breakdown");

const baseLabel = document.getElementById("breakdown-base-label");
const baseValue = document.getElementById("breakdown-base-value");

const discountRow = document.getElementById("breakdown-discount-row");
const discountValue = document.getElementById("breakdown-discount");

const totalLabel = document.getElementById("breakdown-total-label");
const totalValue = document.getElementById("breakdown-total");

const perPersonSection = document.getElementById("breakdown-per-person");
const perPersonValue = document.getElementById("breakdown-per-person-value");
        let pricing = {};

        const btnNext1 = document.getElementById("btn-next-1");
        const btnBack1 = document.getElementById("btn-back-1");
        const btnPay = document.getElementById("btn-pay");
        const btnCash = document.getElementById("btn-cash");

        const step1 = document.getElementById("form-step-1");
        const step2 = document.getElementById("form-step-2");

        const dot1 = document.getElementById("step-id-1");
        const dot2 = document.getElementById("step-id-2");
        const dot3 = document.getElementById("step-id-3");

        // Set initial date to tomorrow
        const dateInput = document.getElementById("tour-date");
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        dateInput.value = tomorrow.toISOString().split('T')[0];

        // Read URL query parameter "?tour=street-food"
        const urlParams = new URLSearchParams(window.location.search);
        const tourQuery = urlParams.get('tour');
        if (tourQuery) {
            tourSelect.value = tourQuery;
        }
        
        fetch("/api/pricing")
    .then(response => response.json())
    .then(data => {
        pricing = data;
        calculateTotal();
        console.log("Pricing loaded:", pricing);
    })
    .catch(error => {
        console.error("Pricing API failed:", error);
    });
        let currentTotal = 0;
       function calculateTotal() {

    const guests = parseInt(tourGuests.value, 10) || 1;
    const tourId = tourSelect.value;

    // ---------- Dynamic pricing ----------
    if (pricing[tourId] && pricing[tourId][guests]) {

        const total = pricing[tourId][guests];
        currentTotal = total;

        const regularPerPerson = pricing[tourId][1];

        breakdown.style.display = "block";

        baseValue.textContent =
            `${regularPerPerson.toLocaleString("en-US")} pesos`;

        if (guests === 1) {

            document.getElementById("breakdown-total-row").style.display = "flex";
perPersonSection.style.display = "none";
            discountRow.style.display = "none";
            perPersonSection.style.display = "none";

            totalLabel.textContent = "Total";

        } else {

            document.getElementById("breakdown-total-row").style.display = "flex";
perPersonSection.style.display = "block";

            const newPerPerson =
                Math.round(total / guests);

            const savingsPerPerson =
                regularPerPerson - newPerPerson;

            discountRow.style.display = "flex";

            perPersonSection.style.display = "block";

            discountValue.textContent =
                `− ${savingsPerPerson.toLocaleString("en-US")} pesos per person`;

            perPersonValue.textContent =
                `${newPerPerson.toLocaleString("en-US")} pesos`;

            totalLabel.textContent =
                `Total for ${guests} guests`;

        }

        totalValue.textContent =
            `${total.toLocaleString("en-US")} pesos`;

        return;
    }

    // ---------- Fallback ----------
    const selectedOption =
        tourSelect.options[tourSelect.selectedIndex];

    if (!selectedOption || !selectedOption.dataset.price) {

        breakdown.style.display = "none";
        return;

    }

    const total =
        guests * parseInt(selectedOption.dataset.price, 10);

    currentTotal = total;

    breakdown.style.display = "none";

}

        tourSelect.addEventListener("change", calculateTotal);

        qtyMinus.addEventListener("click", () => {
            let val = parseInt(tourGuests.value, 10);
            if (val > 1) {
                tourGuests.value = (val - 1).toString();
                calculateTotal();
            }
        });

        qtyPlus.addEventListener("click", () => {
            let val = parseInt(tourGuests.value, 10);
            if (val < 10) {
                tourGuests.value = (val + 1).toString();
                calculateTotal();
            }
        });

        // Initialize total
        calculateTotal();

        // -------------------------
        // Steps Navigation
        // -------------------------
        btnNext1.addEventListener("click", () => {
            if (!tourSelect.value) {
                alert("Please select a tour to continue.");
                return;
            }
            step1.classList.remove("active");
            step2.classList.add("active");
            dot2.classList.add("active");
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        btnBack1.addEventListener("click", () => {
            step2.classList.remove("active");
            step1.classList.add("active");
            dot2.classList.remove("active");
        });

        btnCash.addEventListener("click", async () => {
    const name = document.getElementById("user-name").value;
    if (!name) {
        alert("Please enter your name.");
        return;
    }
    btnCash.disabled = true;

btnCash.innerHTML = `
    <span class="spinner"></span>
    Sending Reservation...
`;

    await fetch("https://hook.us2.make.com/ein1uecrgrka4ga260zay681vy05che9", {
        method: "POST",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            tour: tourSelect.options[tourSelect.selectedIndex].text,
            tour_id: tourSelect.value,
            date: document.getElementById("tour-date").value,
            time: document.getElementById("tour-time").value,
            guests: tourGuests.value,
            name: document.getElementById("user-name").value,
            email: document.getElementById("user-email").value,
            phone: document.getElementById("user-phone").value,
            total: currentTotal
        })
    });

    sessionStorage.setItem(
    "cashReservation",
    JSON.stringify({
        tour: tourSelect.options[tourSelect.selectedIndex].text,
        guests: Number(tourGuests.value),
        date: document.getElementById("tour-date").value,
        time: document.getElementById("tour-time").value,
        originalPrice: currentTotal,
        discount: Math.round(currentTotal * 0.10),
        finalPrice: Math.round(currentTotal * 0.90)
    })
);

    const overlay = document.getElementById("loading-overlay");

overlay.classList.add("show");

setTimeout(() => {
    window.location.href = "/reservation-confirmed";
}, 2500);

});
        // Upon click "Proceed to Payment" we pretend it moves to step 3 while opening the checkout link
        btnPay.addEventListener("click", async (event) => {
            event.preventDefault();

            const paymentWindow = window.open("", "_blank");

if (!paymentWindow) {
    alert("Please allow pop-ups to continue to payment.");
    return;
}

            const name = document.getElementById("user-name").value;
            if(!name) {
                alert("Please enter your name.");
                return;
            }
fetch("https://hook.us2.make.com/ein1uecrgrka4ga260zay681vy05che9", {
    method: "POST",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({
    tour: tourSelect.options[tourSelect.selectedIndex].text,
    tour_id: tourSelect.value,
    date: document.getElementById("tour-date").value,
    time: document.getElementById("tour-time").value,
    guests: tourGuests.value,
    name: document.getElementById("user-name").value,
    email: document.getElementById("user-email").value,
    phone: document.getElementById("user-phone").value,
    total: currentTotal
    })
});

            const response = await fetch("/api/create-payment-link", {
    method: "POST",
    headers: {
        "Content-Type": "application/json"
    },
    body: JSON.stringify({
    amount: currentTotal,
    name: document.getElementById("user-name").value
})
});

const data = await response.json();

paymentWindow.location.href = data.payload.url;
            dot3.classList.add("active");
            // The link acts normally due to the `href` and `target="_blank"` attributes.
            // In a real app we'd capture data and send to a webhook here.
        });
    });
</script>
