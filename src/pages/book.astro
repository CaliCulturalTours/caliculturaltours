---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/site_content_skeleton.json';

const { tours } = content;

// We extract base prices by removing non-numeric characters for calculation purposes
const tourData = tours.map(t => {
    // Extract numbers: "From 95,000 COP" -> 95000
    const priceStr = t.price.replace(/[^0-9]/g, '');
    return {
        id: t.id,
        title: t.title,
        price: parseInt(priceStr, 10) || 0
    };
});
---

<BaseLayout title="Book Your Cali Tour Online" description="Book your authentic Cali cultural, salsa, food, or nature tour online. Instant confirmation, secure payment, or pay in cash on arrival.">
    <section class="section section-light" style="background: #fafafa; min-height: 80vh;">
        <div class="container reveal">
            <!-- Header -->
            <div style="text-align: center; margin-bottom: 48px;">
                <h1 class="text-serif" style="font-size: 3rem; margin-bottom: 8px;">Book Your <span style="color: var(--cct-primary);">Tour</span></h1>
                <p style="color: var(--cct-text-light); font-size: 1.15rem;">Secure your spot in 3 easy steps</p>

                <!-- Stepper -->
                <div class="stepper-container">
                    <div class="step active" id="step-id-1">1</div>
                    <div class="step-line"></div>
                    <div class="step" id="step-id-2">2</div>
                    <div class="step-line"></div>
                    <div class="step" id="step-id-3">3</div>
                </div>
            </div>

            <!-- Form Card -->
            <div class="booking-card">
                <!-- STEP 1: Experience -->
                <div id="form-step-1" class="form-step active">
                    <h2 style="font-size: 1.5rem; margin-bottom: 24px; font-family: var(--font-serif);">Select Your Experience</h2>
                    
                    <div class="form-group">
                        <label class="form-label">Tour</label>
                        <select id="tour-select" class="form-control">
                            <option value="" disabled selected>Select a tour...</option>
                            {tourData.map(tour => (
                                <option value={tour.id} data-price={tour.price}>{tour.title}</option>
                            ))}
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex: 1;">
                            <label class="form-label">Tour Date</label>
                            <input type="date" id="tour-date" class="form-control" />

<small style="color: var(--cct-text-light); display:block; margin-top:8px;">
    Need a tour today?
    <a href="https://wa.me/573162543554" target="_blank">
        Contact us on WhatsApp
    </a>
    to confirm availability.
</small>
                        </div>
                       <div class="form-group" style="flex: 1;">
    <label class="form-label">Preferred Start Time</label>
    <select id="tour-time" class="form-control">
        <option value="" disabled selected>Select a start time...</option>

        <option value="06:00 AM">06:00 AM</option>
        <option value="08:00 AM">08:00 AM</option>
        <option value="09:30 AM">09:30 AM</option>
        <option value="11:00 AM">11:00 AM</option>
        <option value="12:30 PM">12:30 PM</option>
        <option value="02:00 PM">02:00 PM</option>
        <option value="03:30 PM">03:30 PM</option>
        <option value="06:00 PM">06:00 PM</option>
        <option value="Other time">Other time</option>
    </select>
</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Number of Guests (Max 10)</label>
                        <div class="guest-counter">
                            <button type="button" class="qty-btn" id="qty-minus">-</button>
                            <input type="number" id="tour-guests" value="1" min="1" max="10" readonly />
                            <button type="button" class="qty-btn" id="qty-plus">+</button>
                        </div>
                    </div>

                    <div class="form-group coupon-group">
                        <label class="form-label" for="coupon-input">
                            Promo / Partner Code <span style="font-weight:400; color:var(--cct-text-light);">(Optional)</span>
                        </label>
                        <div class="coupon-input-row">
                            <input
                                type="text"
                                id="coupon-input"
                                class="form-control"
                                placeholder="Enter partner code"
                                autocomplete="off"
                                maxlength="40"
                            />
                            <button type="button" id="btn-apply-coupon" class="btn btn-outline coupon-btn">
                                Apply
                            </button>
                            <button type="button" id="btn-remove-coupon" class="btn btn-outline coupon-btn coupon-remove-btn" style="display:none;">
                                Remove
                            </button>
                        </div>
                        <div id="coupon-feedback" class="coupon-feedback" aria-live="polite"></div>
                    </div>

                    <div
    id="price-breakdown"
    style="
        display:none;
        background:#fafafa;
        border:1px solid #e6e6e6;
        border-radius:12px;
        padding:18px;
        margin-bottom:24px;
    ">

    <div
        style="
            display:flex;
            justify-content:space-between;
            margin-bottom:8px;
        ">
        <span>Price per person</span>
        <span id="breakdown-base-value"></span>
    </div>

    <div
        id="breakdown-discount-row"
        style="
            display:none;
            justify-content:space-between;
            color:#198754;
            margin-bottom:12px;
        ">
        <span>Group discount</span>
        <span id="breakdown-discount"></span>
    </div>

    <div
        id="breakdown-coupon-row"
        style="
            display:none;
            justify-content:space-between;
            color:#198754;
            font-weight:600;
            margin-bottom:12px;
        ">
        <span id="breakdown-coupon-label">Partner coupon</span>
        <span id="breakdown-coupon-value"></span>
    </div>

    <hr style="border:none;border-top:1px solid #ddd;margin:12px 0;">

    <div
        id="breakdown-total-row"
        style="
            display:flex;
            justify-content:space-between;
            align-items:center;
        ">
        <strong id="breakdown-total-label">
            Total
        </strong>

        <span
            id="breakdown-total"
            style="
                font-size:1.5rem;
                font-family:var(--font-serif);
                font-weight:800;
                color:var(--cct-primary);
            ">
        </span>
    </div>

    <div
        id="breakdown-per-person"
        style="
            display:none;
            text-align:center;
            margin-top:20px;
        ">

        <div
            style="
                font-size:.82rem;
                color:#777;
                text-transform:uppercase;
                letter-spacing:.08em;
            ">
            Your price per person
        </div>

        <div
            id="breakdown-per-person-value"
            style="
                font-size:2rem;
                font-family:var(--font-serif);
                font-weight:800;
                color:var(--cct-primary);
                margin-top:4px;
            ">
        </div>

    </div>

</div>

                    <button type="button" class="btn btn-primary btn-block" id="btn-next-1" style="padding: 16px; font-size: 1.1rem;">Continue</button>
                </div>

                <!-- STEP 2: Details -->
                <div id="form-step-2" class="form-step">
                    <h2 style="font-size: 1.5rem; margin-bottom: 24px; font-family: var(--font-serif);">Your Details</h2>
                    
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" id="user-name" class="form-control" placeholder="John Doe" />
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <input type="email" id="user-email" class="form-control" placeholder="john@example.com" />
                    </div>
                    
                    <div class="form-group">
    <label class="form-label">WhatsApp Number</label>

    <div style="display: flex; gap: 8px;">
        <select
            id="phone-country"
            class="form-control"
            style="width: 150px; flex-shrink: 0;"
            aria-label="Country code"
        >
            <option value="+1">🇺🇸 +1</option>
            <option value="+57">🇨🇴 +57</option>

            <option value="+61">🇦🇺 +61</option>
            <option value="+55">🇧🇷 +55</option>
            <option value="+1">🇨🇦 +1</option>
            <option value="+33">🇫🇷 +33</option>
            <option value="+49">🇩🇪 +49</option>
            <option value="+39">🇮🇹 +39</option>
            <option value="+52">🇲🇽 +52</option>
            <option value="+31">🇳🇱 +31</option>
            <option value="+34">🇪🇸 +34</option>
            <option value="+41">🇨🇭 +41</option>
            <option value="+44">🇬🇧 +44</option>
            <option value="+other">🌎 Other</option>
        </select>

        <input
            type="tel"
            id="user-phone"
            class="form-control"
            placeholder="234 567 8900"
            autocomplete="tel-national"
        />
    </div>

    <small style="color: var(--cct-text-light); display: block; margin-top: 8px;">
        Select your country code and enter your WhatsApp number.
    </small>
</div>

                    <div id="step2-summary" class="step2-summary" style="display:none;">
                        <div class="step2-summary-row">
                            <span>Online payment total</span>
                            <strong id="step2-online-total"></strong>
                        </div>
                        <div class="step2-summary-row step2-cash-row">
                            <span>Cash total (extra 10% off)</span>
                            <strong id="step2-cash-total"></strong>
                        </div>
                        <div id="step2-coupon-pill" class="step2-coupon-pill" style="display:none;"></div>
                    </div>

                    <div class="form-row-buttons">
    <button type="button" class="btn btn-outline" id="btn-back-1" style="flex: 1;">
        Back
    </button>
</div>

<div class="form-row-buttons" style="margin-top: 12px;">
    <button type="button" class="btn btn-outline" id="btn-cash" style="flex: 1;">
        💵 Reserve &amp; Pay Cash · Save 10%
    </button>
</div>

<div class="form-row-buttons" style="margin-top: 12px;">
    <a href="#" class="btn btn-primary" id="btn-pay" style="flex: 1;">
        💳 Continue to Online Payment
    </a>
</div>
                </div>

            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .stepper-container {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 300px;
        margin: 0 auto;
        gap: 16px;
    }
    .step {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #eee;
        color: #999;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .step.active {
        background: var(--cct-primary);
        color: white;
        box-shadow: 0 4px 10px rgba(232, 0, 90, 0.3);
    }
    .step-line {
        height: 2px;
        flex: 1;
        background: #eee;
    }
    
    .booking-card {
        background: white;
        max-width: 600px;
        margin: 0 auto;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
    }
    
    .form-step {
        display: none;
        animation: fadeIn 0.4s ease forwards;
    }
    .form-step.active {
        display: block;
    }
    
    .form-group {
        margin-bottom: 24px;
    }
    .form-row {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    .form-row-buttons {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }
    
    .form-label {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--cct-text-main);
    }
    
    .form-control {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #ddd;
        border-radius: 12px;
        font-size: 1rem;
        font-family: var(--font-body);
        color: var(--cct-text-main);
        background: #fafafa;
        transition: border-color 0.2s ease;
    }
    .form-control:focus {
        outline: none;
        border-color: var(--cct-primary);
        background: white;
    }
    
    .guest-counter {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .qty-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #ddd;
        background: white;
        font-weight: 700;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--cct-text-main);
    }
    .qty-btn:hover {
        border-color: var(--cct-primary);
        color: var(--cct-primary);
    }
    #tour-guests {
        width: 50px;
        text-align: center;
        border: none;
        font-size: 1.1rem;
        font-weight: 700;
        background: transparent;
    }
    
    .total-box {
        background: #fdf2f7;
        padding: 20px 24px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        border: 1px solid #fae3ef;
    }
    
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 600px) {
        .booking-card {
            padding: 24px;
        }
        .form-row {
            flex-direction: column;
            gap: 0;
        }
    }

    .coupon-input-row {
        display: flex;
        gap: 8px;
        align-items: stretch;
    }
    .coupon-input-row .form-control {
        flex: 1;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .coupon-btn {
        padding: 10px 18px !important;
        white-space: nowrap;
        flex-shrink: 0;
        border-radius: 10px;
        font-weight: 700;
    }
    .coupon-remove-btn {
        color: #dc2626 !important;
        border-color: #fecaca !important;
    }
    .coupon-remove-btn:hover {
        background: #fef2f2 !important;
    }
    .coupon-feedback {
        font-size: 0.88rem;
        margin-top: 8px;
        min-height: 1.2em;
    }
    .coupon-feedback.success {
        color: #15803d;
        font-weight: 600;
    }
    .coupon-feedback.error {
        color: #dc2626;
        font-weight: 500;
    }
    .step2-summary {
        background: #fdf2f7;
        border: 1px solid #fae1ec;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 18px;
    }
    .step2-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.94rem;
        color: #374151;
        margin-bottom: 6px;
    }
    .step2-cash-row {
        color: #15803d;
        margin-bottom: 0;
    }
    .step2-coupon-pill {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px dashed #f5b8d0;
        font-size: 0.85rem;
        font-weight: 700;
        color: #15803d;
    }
</style>

<div id="loading-overlay" class="loading-overlay">

    <img
        src="/images/logo.jpg"
        alt="Cali Cultural Tours"
        class="loading-logo"
    >

    <div class="loading-spinner"></div>

    <h2 class="loading-title">
        Preparing your reservation...
    </h2>

    <p class="loading-text">
        Please wait while we save your reservation.
    </p>

</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Elements
        const tourSelect = document.getElementById("tour-select");
        const qtyMinus = document.getElementById("qty-minus");
        const qtyPlus = document.getElementById("qty-plus");
        const tourGuests = document.getElementById("tour-guests");
        const breakdown = document.getElementById("price-breakdown");

const baseLabel = document.getElementById("breakdown-base-label");
const baseValue = document.getElementById("breakdown-base-value");

const discountRow = document.getElementById("breakdown-discount-row");
const discountValue = document.getElementById("breakdown-discount");

const totalLabel = document.getElementById("breakdown-total-label");
const totalValue = document.getElementById("breakdown-total");

const perPersonSection = document.getElementById("breakdown-per-person");
const perPersonValue = document.getElementById("breakdown-per-person-value");

const couponInput = document.getElementById("coupon-input");
const btnApplyCoupon = document.getElementById("btn-apply-coupon");
const btnRemoveCoupon = document.getElementById("btn-remove-coupon");
const couponFeedback = document.getElementById("coupon-feedback");
const couponRow = document.getElementById("breakdown-coupon-row");
const couponRowLabel = document.getElementById("breakdown-coupon-label");
const couponRowValue = document.getElementById("breakdown-coupon-value");

const step2Summary = document.getElementById("step2-summary");
const step2OnlineTotal = document.getElementById("step2-online-total");
const step2CashTotal = document.getElementById("step2-cash-total");
const step2CouponPill = document.getElementById("step2-coupon-pill");

        let pricing = {};
        let appliedCoupon = null; // { code, discountPercent, partnerName }
        let baseTotalBeforeCoupon = 0;
        let couponDiscountAmount = 0;

        const btnNext1 = document.getElementById("btn-next-1");
        const btnBack1 = document.getElementById("btn-back-1");
        const btnPay = document.getElementById("btn-pay");
        const btnCash = document.getElementById("btn-cash");

        const step1 = document.getElementById("form-step-1");
        const step2 = document.getElementById("form-step-2");

        const dot1 = document.getElementById("step-id-1");
        const dot2 = document.getElementById("step-id-2");
        const dot3 = document.getElementById("step-id-3");

        // Set initial date to tomorrow
        const dateInput = document.getElementById("tour-date");
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        dateInput.value = tomorrow.toISOString().split('T')[0];

        // Read URL query parameters "?tour=...&coupon=..."
        const urlParams = new URLSearchParams(window.location.search);
        const tourQuery = urlParams.get('tour');
        if (tourQuery) {
            tourSelect.value = tourQuery;
        }
        const couponQuery = urlParams.get('coupon') || urlParams.get('code');

        fetch("/api/pricing")
    .then(response => response.json())
    .then(data => {
        pricing = data;
        calculateTotal();
        console.log("Pricing loaded:", pricing);
    })
    .catch(error => {
        console.error("Pricing API failed:", error);
    });

        let currentTotal = 0;

        function updateStep2Summary() {
            if (!step2Summary || currentTotal <= 0) {
                if (step2Summary) step2Summary.style.display = "none";
                return;
            }
            const cashTotal = Math.round(currentTotal * 0.90);
            step2Summary.style.display = "block";
            step2OnlineTotal.textContent = `${currentTotal.toLocaleString("en-US")} COP`;
            step2CashTotal.textContent = `${cashTotal.toLocaleString("en-US")} COP`;

            if (appliedCoupon) {
                step2CouponPill.style.display = "block";
                step2CouponPill.textContent = `✓ Code ${appliedCoupon.code} applied (-${appliedCoupon.discountPercent}% · stacks with 10% cash discount)`;
            } else {
                step2CouponPill.style.display = "none";
                step2CouponPill.textContent = "";
            }
        }

        function calculateTotal() {
            const guests = parseInt(tourGuests.value, 10) || 1;
            const tourId = tourSelect.value;

            let subtotal = 0;
            let regularPerPerson = 0;
            let hasDynamicPricing = false;

            if (pricing[tourId] && pricing[tourId][guests]) {
                subtotal = pricing[tourId][guests];
                regularPerPerson = pricing[tourId][1];
                hasDynamicPricing = true;
            } else {
                const selectedOption = tourSelect.options[tourSelect.selectedIndex];
                if (!selectedOption || !selectedOption.dataset.price) {
                    baseTotalBeforeCoupon = 0;
                    couponDiscountAmount = 0;
                    currentTotal = 0;
                    breakdown.style.display = "none";
                    updateStep2Summary();
                    return;
                }
                regularPerPerson = parseInt(selectedOption.dataset.price, 10);
                subtotal = guests * regularPerPerson;
            }

            baseTotalBeforeCoupon = subtotal;
            couponDiscountAmount = appliedCoupon
                ? Math.round(subtotal * (appliedCoupon.discountPercent / 100))
                : 0;
            currentTotal = Math.max(0, subtotal - couponDiscountAmount);

            breakdown.style.display = "block";
            baseValue.textContent = `${regularPerPerson.toLocaleString("en-US")} pesos`;
            document.getElementById("breakdown-total-row").style.display = "flex";

            // Group discount row (when dynamic pricing offers multi-guest savings)
            if (hasDynamicPricing && guests > 1) {
                const groupPerPerson = Math.round(subtotal / guests);
                const savingsPerPerson = regularPerPerson - groupPerPerson;
                if (savingsPerPerson > 0) {
                    discountRow.style.display = "flex";
                    discountValue.textContent = `− ${savingsPerPerson.toLocaleString("en-US")} pesos per person`;
                } else {
                    discountRow.style.display = "none";
                }
            } else {
                discountRow.style.display = "none";
            }

            // Partner coupon row (cumulative on top of group price)
            if (appliedCoupon && couponDiscountAmount > 0) {
                couponRow.style.display = "flex";
                couponRowLabel.textContent = `Promo code (${appliedCoupon.code} · ${appliedCoupon.discountPercent}% off)`;
                couponRowValue.textContent = `− ${couponDiscountAmount.toLocaleString("en-US")} pesos`;
            } else {
                couponRow.style.display = "none";
            }

            // Per-person display (show when > 1 guest OR when coupon reduces the single-guest price)
            if (guests > 1 || appliedCoupon) {
                const finalPerPerson = Math.round(currentTotal / guests);
                perPersonSection.style.display = "block";
                perPersonValue.textContent = `${finalPerPerson.toLocaleString("en-US")} pesos`;
            } else {
                perPersonSection.style.display = "none";
            }

            totalLabel.textContent = guests === 1 ? "Total" : `Total for ${guests} guests`;
            totalValue.textContent = `${currentTotal.toLocaleString("en-US")} pesos`;

            updateStep2Summary();
        }

        async function applyCouponCode(rawCode) {
            const code = String(rawCode || "").trim().toUpperCase();
            if (!code) {
                couponFeedback.className = "coupon-feedback error";
                couponFeedback.textContent = "Please enter a promo code.";
                return;
            }

            btnApplyCoupon.disabled = true;
            btnApplyCoupon.textContent = "Checking...";
            couponFeedback.className = "coupon-feedback";
            couponFeedback.textContent = "";

            try {
                const res = await fetch("/api/validate-coupon", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ code })
                });
                const result = await res.json();

                if (result.valid) {
                    appliedCoupon = {
                        code: result.code,
                        discountPercent: result.discountPercent,
                        partnerName: result.partnerName || ""
                    };
                    couponInput.value = result.code;
                    couponInput.readOnly = true;
                    btnApplyCoupon.style.display = "none";
                    btnRemoveCoupon.style.display = "inline-block";
                    couponFeedback.className = "coupon-feedback success";
                    couponFeedback.textContent = `✓ Code ${result.code} applied: ${result.discountPercent}% off! (Stacks with our 10% cash discount)`;
                    calculateTotal();
                } else {
                    appliedCoupon = null;
                    couponFeedback.className = "coupon-feedback error";
                    couponFeedback.textContent = result.error || "Invalid promo code.";
                    calculateTotal();
                }
            } catch (err) {
                console.error("Coupon validation failed:", err);
                couponFeedback.className = "coupon-feedback error";
                couponFeedback.textContent = "Could not verify code right now. Please try again.";
            } finally {
                btnApplyCoupon.disabled = false;
                btnApplyCoupon.textContent = "Apply";
            }
        }

        btnApplyCoupon?.addEventListener("click", () => applyCouponCode(couponInput.value));
        couponInput?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                if (!appliedCoupon) applyCouponCode(couponInput.value);
            }
        });
        btnRemoveCoupon?.addEventListener("click", () => {
            appliedCoupon = null;
            couponInput.readOnly = false;
            couponInput.value = "";
            btnRemoveCoupon.style.display = "none";
            btnApplyCoupon.style.display = "inline-block";
            couponFeedback.className = "coupon-feedback";
            couponFeedback.textContent = "";
            calculateTotal();
        });

        if (couponQuery) {
            couponInput.value = couponQuery.trim().toUpperCase();
            applyCouponCode(couponQuery);
        }

        tourSelect.addEventListener("change", calculateTotal);

        qtyMinus.addEventListener("click", () => {
            let val = parseInt(tourGuests.value, 10);
            if (val > 1) {
                tourGuests.value = (val - 1).toString();
                calculateTotal();
            }
        });

        qtyPlus.addEventListener("click", () => {
            let val = parseInt(tourGuests.value, 10);
            if (val < 10) {
                tourGuests.value = (val + 1).toString();
                calculateTotal();
            }
        });

        // Initialize total
        calculateTotal();

        // -------------------------
        // Steps Navigation
        // -------------------------
        btnNext1.addEventListener("click", () => {
            if (!tourSelect.value) {
                alert("Please select a tour to continue.");
                return;
            }
            step1.classList.remove("active");
            step2.classList.add("active");
            dot2.classList.add("active");
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        btnBack1.addEventListener("click", () => {
            step2.classList.remove("active");
            step1.classList.add("active");
            dot2.classList.remove("active");
        });

        btnCash.addEventListener("click", async () => {

    const name = document.getElementById("user-name").value;

    if (!name) {
        alert("Please enter your name.");
        return;
    }

    btnCash.disabled = true;

    btnCash.innerHTML = `
