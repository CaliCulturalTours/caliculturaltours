            phone: `${document.getElementById("phone-country").value}${document.getElementById("user-phone").value.replace(/\D/g, "")}`,
            base_total: baseTotalBeforeCoupon,
            coupon_code: appliedCoupon ? appliedCoupon.code : "",
            total: Math.round(currentTotal * 0.90),
            payment_status: "Cash"
            })
        });

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.error || "Booking could not be saved.");
        }

        const cashOnlyDiscount = Math.round(currentTotal * 0.10);
        const finalCashAmount = Math.round(currentTotal * 0.90);

        sessionStorage.setItem(
            "cashReservation",
            JSON.stringify({
                tour: tourSelect.options[tourSelect.selectedIndex].text,
                guests: Number(tourGuests.value),
                date: document.getElementById("tour-date").value,
                time: document.getElementById("tour-time").value,
                originalPrice: baseTotalBeforeCoupon || currentTotal,
                couponCode: appliedCoupon ? appliedCoupon.code : "",
                couponPercent: appliedCoupon ? appliedCoupon.discountPercent : 0,
                couponDiscount: couponDiscountAmount,
                cashDiscount: cashOnlyDiscount,
                discount: cashOnlyDiscount,
                finalPrice: finalCashAmount,
                bookingReference: data.booking_reference
            })
        );

        // OpenAI Ads Conversion Trigger (Pixel) - Confirmed Booking
        try {
            const sentKey = "oai_conversion_sent_" + data.booking_reference;
            if (!sessionStorage.getItem(sentKey)) {
                if (typeof window.oaiq === "function") {
                    window.oaiq("measure", "appointment_scheduled", {
                        id: data.booking_reference,
                        event_id: data.booking_reference,
                        type: "customer_action"
                    });
                    sessionStorage.setItem(sentKey, "true");
                }
            }
        } catch (oaiErr) {
            console.error("OpenAI Ads measurement error:", oaiErr);
        }

        const overlay = document.getElementById("loading-overlay");

        overlay.classList.add("show");

        setTimeout(() => {
            window.location.href = "/reservation-confirmed";
        }, 1500);

    } catch (error) {

        console.error("Booking failed:", error);

        alert(
            "We couldn't complete your reservation. Please try again or contact us on WhatsApp."
        );

        btnCash.disabled = false;

        btnCash.innerHTML = `
            💵 Reserve &amp; Pay Cash · Save 10%
        `;
    }
});

