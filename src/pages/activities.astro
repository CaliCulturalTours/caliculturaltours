<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const strip = document.getElementById('actDayStrip');
    if (!strip) return;

    let selectedDay = strip.dataset.defaultDay || 'week';
    const todayKey = strip.dataset.todayKey || '';
    let selectedFilter = 'all';
    let searchTerm = '';

    const dayPills = Array.from(document.querySelectorAll('.act-day-pill'));
    const filterChips = Array.from(document.querySelectorAll('.act-chip'));
    const searchInput = document.getElementById('actSearchInput');
    const dayGroups = Array.from(document.querySelectorAll('.act-day-group'));
    const statusText = document.getElementById('actStatusText');
    const resetBtn = document.getElementById('actResetFiltersBtn');
    const noResults = document.getElementById('actNoResults');
    const showWeekBtn = document.getElementById('actShowWeekBtn');
    const clearAllBtn = document.getElementById('actClearAllBtn');

    // Mark "LIVE NOW" and "Earlier today" dynamically based on America/Bogota (UTC-5) time
    function updateLiveBadges() {
      const bogotaNow = new Date(Date.now() - 5 * 60 * 60 * 1000);
      const bogotaDateKey = bogotaNow.toISOString().slice(0, 10);
      const nowMins = bogotaNow.getUTCHours() * 60 + bogotaNow.getUTCMinutes();

      document.querySelectorAll('.act-card').forEach((card) => {
        if (card.dataset.date !== bogotaDateKey) return;
        const startMin = Number(card.dataset.startMin || 0);
        const endMin = Number(card.dataset.endMin || startMin + 60);
        const badge = card.querySelector('[data-live-badge]');
        if (!badge) return;

        if (nowMins >= startMin && nowMins <= endMin) {
          badge.textContent = '● LIVE NOW';
          badge.className = 'act-live-status live-now';
          badge.style.display = 'inline-block';
          card.classList.remove('is-past');
        } else if (nowMins > endMin) {
          badge.textContent = 'Earlier today';
          badge.className = 'act-live-status past-today';
          badge.style.display = 'inline-block';
          card.classList.add('is-past');
        }
      });
    }

    function applyView() {
      const q = searchTerm.trim().toLowerCase();
      let totalVisibleEvents = 0;

      dayGroups.forEach((group) => {
        const dayKey = group.dataset.dayGroup;
        const inWeek = group.dataset.inWeek === '1';
        const dayMatches =
          q.length > 0
            ? true // When searching, search across all 14 days automatically!
            : selectedDay === 'week'
              ? inWeek
              : dayKey === selectedDay;

        if (!dayMatches) {
          group.style.display = 'none';
          return;
        }

        const cards = Array.from(group.querySelectorAll('.act-card'));
        let groupVisibleCount = 0;

        cards.forEach((card) => {
          const cat = card.dataset.category;
          const isFree = card.dataset.free === '1';
          const hay = card.dataset.search || '';

          const filterOk =
            selectedFilter === 'all' ||
            (selectedFilter === 'free' ? isFree : cat === selectedFilter);
          const searchOk = !q || hay.includes(q);

          if (filterOk && searchOk) {
            card.style.display = '';
            groupVisibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        const countLabel = group.querySelector('[data-day-count-label]');
        if (countLabel) {
          countLabel.textContent = `${groupVisibleCount} ${groupVisibleCount === 1 ? 'activity' : 'activities'}`;
        }

        // In week or search mode, hide days with 0 matching events
        if ((selectedDay === 'week' || q.length > 0 || selectedFilter !== 'all') && groupVisibleCount === 0) {
          group.style.display = 'none';
        } else {
          group.style.display = '';
        }

        totalVisibleEvents += groupVisibleCount;
      });

      const hasActiveFilters = selectedFilter !== 'all' || q.length > 0;
      if (resetBtn) resetBtn.style.display = hasActiveFilters ? 'inline-block' : 'none';

      if (statusText) {
        if (q.length > 0) {
          statusText.textContent = `${totalVisibleEvents} matching ${totalVisibleEvents === 1 ? 'activity' : 'activities'} across the next 14 days`;
        } else if (selectedDay === 'week') {
          statusText.textContent = `Showing ${totalVisibleEvents} activities for the next 7 days`;
        } else if (selectedDay === todayKey) {
          statusText.textContent = `Showing ${totalVisibleEvents} ${totalVisibleEvents === 1 ? 'activity' : 'activities'} for today`;
        } else {
          statusText.textContent = `Showing ${totalVisibleEvents} ${totalVisibleEvents === 1 ? 'activity' : 'activities'} on selected day`;
        }
      }

      if (noResults) {
        noResults.style.display = totalVisibleEvents === 0 ? 'block' : 'none';
      }
    }

    function selectDay(dayKey, scrollPill = false) {
      selectedDay = dayKey;
      dayPills.forEach((pill) => {
        const active = pill.dataset.day === dayKey;
        pill.classList.toggle('active', active);
        pill.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active && scrollPill) {
          pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
      applyView();
    }

    dayPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        if (searchInput && searchInput.value) {
          searchInput.value = '';
          searchTerm = '';
        }
        selectDay(pill.dataset.day || 'week', true);
      });
    });

    filterChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filterChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        selectedFilter = chip.dataset.filter || 'all';
        applyView();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchTerm = e.target.value || '';
      applyView();
    });

    function resetAllFilters() {
      selectedFilter = 'all';
      searchTerm = '';
      if (searchInput) searchInput.value = '';
      filterChips.forEach((c) => c.classList.toggle('active', c.dataset.filter === 'all'));
      applyView();
    }

    resetBtn?.addEventListener('click', resetAllFilters);
    clearAllBtn?.addEventListener('click', resetAllFilters);
    showWeekBtn?.addEventListener('click', () => {
      resetAllFilters();
      selectDay('week', true);
    });

    // Native mobile share or clipboard fallback for individual events
    document.querySelectorAll('.act-btn-share').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const title = btn.dataset.shareTitle || 'Cali Activity';
        const time = btn.dataset.shareTime || '';
        const venue = btn.dataset.shareVenue || '';
        const shareText = `${title} (${time} · ${venue}) — Cali Cultural Calendar`;
        const shareUrl = window.location.href.split('?')[0];

        if (navigator.share) {
          try {
            await navigator.share({ title, text: shareText, url: shareUrl });
            return;
          } catch {}
        }

        try {
          await navigator.clipboard.writeText(`${shareText} ${shareUrl}`);
          const orig = btn.innerHTML;
          btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
          setTimeout(() => {
            btn.innerHTML = orig;
          }, 1800);
        } catch {}
      });
    });

    updateLiveBadges();
    applyView();
  });
</script>
